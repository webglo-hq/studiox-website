ek:Debit a owl:NamedIndividual, ek:NormalBalance ;
    rdfs:label "Debit" ;
    skos:definition "Left side; increases assets and expenses." .

ek:Credit a owl:NamedIndividual, ek:NormalBalance ;
    rdfs:label "Credit" ;
    skos:definition "Right side; increases liabilities, equity and revenue." .

ek:Open a owl:NamedIndividual, ek:PeriodState ;
    rdfs:label "Open" ;
    skos:definition "All entry types may post (subject to approval)." .

ek:SoftClose a owl:NamedIndividual, ek:PeriodState ;
    rdfs:label "Soft close" ;
    skos:definition "Subledgers closed; only adjusting-type entries by Senior Accountant or above." .

ek:HardClose a owl:NamedIndividual, ek:PeriodState ;
    rdfs:label "Hard close (locked)" ;
    skos:definition "No postings; reopening requires CFO approval with a reason." .

ek:Standard a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Standard entry" ;
    skos:definition "Ordinary transaction entry." .

ek:Adjusting a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Adjusting entry" ;
    skos:definition "Top-side correction made during the close." .

ek:AccrualType a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Accrual entry" ;
    skos:definition "Recognises incurred but unbilled amounts; auto-reverses next period." .

ek:Reversing a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Reversing entry" ;
    skos:definition "Mirror of a posted entry; cancels it." .

ek:Recurring a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Recurring entry" ;
    skos:definition "Template-generated each period." .

ek:Reclass a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Reclassification" ;
    skos:definition "Moves an amount between accounts/dimensions without changing totals." .

ek:Elimination a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Elimination" ;
    skos:definition "Consolidation-only intercompany elimination." .

ek:FxRevaluationType a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "FX revaluation" ;
    skos:definition "Remeasures monetary items at closing rate." .

ek:DepreciationType a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Depreciation" ;
    skos:definition "Fixed-asset depreciation from the register." .

ek:AmortizationType a owl:NamedIndividual, ek:EntryType ;
    rdfs:label "Amortisation" ;
    skos:definition "Prepaid amortisation from schedules." .

ek:Existence a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Existence" ;
    skos:definition "Assets, liabilities and equity interests exist at the balance sheet date." .

ek:Occurrence a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Occurrence" ;
    skos:definition "Recorded transactions and events have occurred and pertain to the entity." .

ek:Completeness a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Completeness" ;
    skos:definition "All transactions and balances that should be recorded have been recorded." .

ek:Accuracy a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Accuracy" ;
    skos:definition "Amounts and data have been recorded appropriately." .

ek:Valuation a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Valuation & allocation" ;
    skos:definition "Balances are included at appropriate amounts and adjustments are recorded." .

ek:Cutoff a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Cutoff" ;
    skos:definition "Transactions are recorded in the correct period." .

ek:Classification a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Classification" ;
    skos:definition "Transactions are recorded in the proper accounts." .

ek:RightsAndObligations a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Rights & obligations" ;
    skos:definition "The entity holds rights to assets and liabilities are its obligations." .

ek:PresentationAndDisclosure a owl:NamedIndividual, ek:Assertion ;
    rdfs:label "Presentation & disclosure" ;
    skos:definition "Components are properly classified, described and disclosed." .

ek:OverallMateriality a owl:NamedIndividual, ek:Materiality ;
    rdfs:label "Overall materiality" ;
    skos:definition "Threshold for the financial statements as a whole (e.g. 1% of revenue)." .

ek:PerformanceMateriality a owl:NamedIndividual, ek:Materiality ;
    rdfs:label "Performance materiality" ;
    skos:definition "Lower threshold used to reduce aggregation risk (typically 50–75% of overall)." .

ek:ClearlyTrivial a owl:NamedIndividual, ek:Materiality ;
    rdfs:label "Clearly trivial" ;
    skos:definition "Threshold below which misstatements are clearly inconsequential (typically ≤5% of overall)." .

ek:L0 a owl:NamedIndividual, ek:AutonomyLevel ;
    rdfs:label "L0 — Suggest" ;
    skos:definition "Agent suggests; a person must act." .

ek:L1 a owl:NamedIndividual, ek:AutonomyLevel ;
    rdfs:label "L1 — Draft for approval" ;
    skos:definition "Agent drafts; every item needs approval before posting." .

ek:L2 a owl:NamedIndividual, ek:AutonomyLevel ;
    rdfs:label "L2 — Auto-post under threshold" ;
    skos:definition "Agent posts items below the policy threshold and confidence floor; a sample is reviewed after posting." .

ek:L3 a owl:NamedIndividual, ek:AutonomyLevel ;
    rdfs:label "L3 — Auto with post-hoc review" ;
    skos:definition "Agent posts verified items; all are reviewed after posting. Never above performance materiality." .

ek:Spot a owl:NamedIndividual, ek:RateType ;
    rdfs:label "Spot rate" ;
    skos:definition "Rate on the transaction date." .

ek:Closing a owl:NamedIndividual, ek:RateType ;
    rdfs:label "Closing rate" ;
    skos:definition "Rate at the balance sheet date; used for monetary items." .

ek:Average a owl:NamedIndividual, ek:RateType ;
    rdfs:label "Average rate" ;
    skos:definition "Period average; used for income statement translation." .

ek:Historical a owl:NamedIndividual, ek:RateType ;
    rdfs:label "Historical rate" ;
    skos:definition "Rate when the item arose; used for equity and non-monetary items." .

ek:ControlEnvironment a owl:NamedIndividual, ek:Control ;
    rdfs:label "Control environment" ;
    skos:definition "COSO component 1 (principles 1–5)." .

ek:RiskAssessment a owl:NamedIndividual, ek:Control ;
    rdfs:label "Risk assessment" ;
    skos:definition "COSO component 2 (principles 6–9)." .

ek:ControlActivities a owl:NamedIndividual, ek:Control ;
    rdfs:label "Control activities" ;
    skos:definition "COSO component 3 (principles 10–12): approvals, reconciliations, SoD." .

ek:InformationCommunication a owl:NamedIndividual, ek:Control ;
    rdfs:label "Information & communication" ;
    skos:definition "COSO component 4 (principles 13–15)." .

ek:MonitoringActivities a owl:NamedIndividual, ek:Control ;
    rdfs:label "Monitoring activities" ;
    skos:definition "COSO component 5 (principles 16–17)." .

ek:BalanceSheet a owl:NamedIndividual, ek:FinancialStatement ;
    rdfs:label "Balance sheet" ;
    skos:definition "Statement of financial position at a date." .

ek:IncomeStatement a owl:NamedIndividual, ek:FinancialStatement ;
    rdfs:label "Income statement" ;
    skos:definition "Statement of operations for a period." .

ek:CashFlowStatement a owl:NamedIndividual, ek:FinancialStatement ;
    rdfs:label "Cash flow statement" ;
    skos:definition "Statement of cash flows for a period." .

ek:PriorMonth a owl:NamedIndividual, ek:ComparisonBasis ;
    rdfs:label "Prior month" ;
    skos:definition "Compare with the immediately preceding period." .

ek:PriorYear a owl:NamedIndividual, ek:ComparisonBasis ;
    rdfs:label "Prior year" ;
    skos:definition "Compare with the same period last year (seasonality)." .

ek:BudgetComparison a owl:NamedIndividual, ek:ComparisonBasis ;
    rdfs:label "Budget" ;
    skos:definition "Compare with the approved budget." .

# Axiom AX-DE-01 (error) on ek:JournalEntry: Debits equal credits
#   ∀ e ∈ JournalEntry: Σ_{l ∈ lines(e)} debit(l) = Σ_{l ∈ lines(e)} credit(l)
# Axiom AX-DE-02 (error) on ek:JournalEntry: Each line is one-sided and positive
#   ∀ l ∈ lines(e): (debit(l) > 0 ∧ credit(l) = 0) ∨ (credit(l) > 0 ∧ debit(l) = 0); amounts ∈ ℤ
# Axiom AX-DE-03 (error) on ek:JournalEntry: At least one debit and one credit
#   ∃ l1, l2 ∈ lines(e): debit(l1) > 0 ∧ credit(l2) > 0
# Axiom AX-DE-04 (error) on ek:JournalEntry: Single-currency entries balance in transaction currency
#   If all lines share txnCurrency k ≠ functional: Σ txnAmount(l) = 0
# Axiom AX-DE-05 (error) on ek:TrialBalance: Accounting equation holds
#   Σ debits = Σ credits over all accounts ⇔ Assets = Liabilities + Equity + (Revenue − Expenses)
# Axiom AX-PER-01 (error) on ek:JournalEntry: Posting requires an open period
#   state(period(e)) = Open ∨ (state = SoftClose ∧ type(e) ∈ AdjustingTypes ∧ role(actor) ≥ Senior)
# Axiom AX-PER-02 (error) on ek:JournalEntry: Entry date within its period
#   start(period(e)) ≤ date(e) ≤ end(period(e))
# Axiom AX-ACC-01 (error) on ek:JournalEntry: Lines post to active, postable accounts
#   ∀ l: account(l) ∈ Accounts(tenant) ∧ postable(account(l)) ∧ active(account(l))
# Axiom AX-ACC-03 (error) on ek:JournalEntry: Required dimensions present
#   ∀ l: requiresDepartment(account(l)) → department(l) ≠ ∅
# Axiom AX-ACC-04 (warning) on ek:JournalEntry: Control accounts are posted through their subledger
#   controlAccount(account(l)) ∧ source(e) ∈ {manual, agent} → flag
# Axiom AX-FX-02 (error) on ek:JournalEntry: Ledger is kept in functional currency
#   currency(e) = functionalCurrency(entity(e))
# Axiom AX-JE-02 (error) on ek:JournalEntry: Reversals mirror the original
#   reverses(e, o) → posted(o) ∧ ¬reversed(o) ∧ entity(e)=entity(o) ∧ date(e) ≥ date(o) ∧ lines(e) = swap(lines(o))
# Axiom AX-JE-03 (error) on ek:JournalEntry: Accruals auto-reverse next period
#   type(e) = Accrual → autoReverseDate(e) = start(period(e) + 1)
# Axiom AX-JE-04 (error) on ek:JournalEntry: Eliminations only in the elimination entity
#   (type(e) = Elimination → entity(e) ∈ EliminationEntity) ∧ (entity(e) ∈ EliminationEntity → type(e) ∈ {Elimination, Reversing ∘ Elimination})
# Axiom AX-IC-02 (error) on ek:JournalEntry: Intercompany lines name the counterparty
#   ∀ l: intercompany(account(l)) → counterparty(l) ∈ Entities ∖ {entity(e)}
# Axiom AX-SOD-01 (error) on ek:JournalEntry: Preparer is not approver
#   approvedBy(e) ≠ ∅ → approvedBy(e) ∉ {preparedBy(e), requestedBy(e)}
# Axiom AX-REC-01 (error) on ek:Reconciliation: Reconciliation ties out
#   certified(r) → |GL(r) − (Statement(r) + Σ reconcilingItems(r))| ≤ tolerance ∧ unexplained(r) = 0
# Axiom AX-REC-02 (error) on ek:Reconciliation: Certified reconciliations carry evidence
#   certified(r) → |evidence(r)| ≥ 1
# Axiom AX-REC-03 (error) on ek:Reconciliation: Reviewer is not the preparer
#   reviewed(r) → reviewer(r) ≠ preparer(r)
# Axiom AX-REC-04 (warning) on ek:Reconciliation: Reconciling items are not stale
#   ∀ i ∈ items(r): age(i) ≤ 90 days
# Axiom AX-FLX-01 (error) on ek:Variance: Material variances are explained
#   material(v) → ∃ x ∈ VarianceExplanation: explains(x, v) ∧ approved(x)
# Axiom AX-FLX-02 (warning) on ek:Variance: Explanations quantify most of the variance
#   explains(x, v) → Σ drivers(x) / variance(v) ≥ 0.8
# Axiom AX-FLX-03 (error) on ek:Variance: Explanation approver is not the author
#   approved(x) → approver(x) ≠ author(x)
# Axiom AX-IC-01 (error) on ek:IntercompanyBalance: Intercompany balances agree
#   |dueFrom(A,B) − dueTo(B,A)|_{reporting ccy} ≤ tolerance
# Axiom AX-MAT-01 (error) on ek:Materiality: Materiality levels are ordered
#   0 < clearlyTrivial < performance ≤ overall
# Axiom AX-CLS-01 (error) on ek:CloseCycle: Task dependencies are acyclic
#   dependsOn⁺ is irreflexive
# Axiom AX-CLS-02 (error) on ek:FiscalPeriod: Lock only a finished close
#   lock(p) → tasks(p) complete ∧ recs(p) reviewed ∧ materialFlux(p) explained ∧ pendingProposals(p) = ∅ ∧ package(p) generated
# Axiom AX-PRP-01 (error) on ek:Proposal: Proposals explain themselves
#   ∀ p ∈ Proposal: |why(p)| > 0 ∧ |evidence(p)| ≥ 1 ∧ confidence(p) ∈ [0,1]
# Axiom AX-PRP-02 (error) on ek:AutonomyLevel: Autonomy ceiling
#   autoPost(p) → level ∈ {L2,L3} ∧ |amount| < performanceMateriality ∧ (level = L3 ∨ (|amount| < threshold ∧ confidence ≥ floor))
# Axiom AX-CAP-01 (warning) on ek:CodingDecision: Equipment above threshold is capitalised
#   concept(t) ⊑ ComputerEquipment ∧ unitCost(t) ≥ capThreshold → treatment(t) = capitalize
# Axiom AX-PPD-01 (warning) on ek:CodingDecision: Multi-month prepayments are deferred
#   servicePeriodMonths(t) > 1 ∧ amount(t) ≥ prepaidThreshold → treatment(t) = prepaid
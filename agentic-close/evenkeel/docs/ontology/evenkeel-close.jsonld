      ],
      "rdfs:label": "Soft close",
      "skos:definition": "Subledgers closed; only adjusting-type entries by Senior Accountant or above.",
      "ek:allowsPosting": "adjusting-only"
    },
    {
      "@id": "ek:HardClose",
      "@type": [
        "owl:NamedIndividual",
        "ek:PeriodState"
      ],
      "rdfs:label": "Hard close (locked)",
      "skos:definition": "No postings; reopening requires CFO approval with a reason.",
      "ek:allowsPosting": false
    },
    {
      "@id": "ek:Standard",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Standard entry",
      "skos:definition": "Ordinary transaction entry."
    },
    {
      "@id": "ek:Adjusting",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Adjusting entry",
      "skos:definition": "Top-side correction made during the close."
    },
    {
      "@id": "ek:AccrualType",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Accrual entry",
      "skos:definition": "Recognises incurred but unbilled amounts; auto-reverses next period."
    },
    {
      "@id": "ek:Reversing",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Reversing entry",
      "skos:definition": "Mirror of a posted entry; cancels it."
    },
    {
      "@id": "ek:Recurring",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Recurring entry",
      "skos:definition": "Template-generated each period."
    },
    {
      "@id": "ek:Reclass",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Reclassification",
      "skos:definition": "Moves an amount between accounts/dimensions without changing totals."
    },
    {
      "@id": "ek:Elimination",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Elimination",
      "skos:definition": "Consolidation-only intercompany elimination."
    },
    {
      "@id": "ek:FxRevaluationType",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "FX revaluation",
      "skos:definition": "Remeasures monetary items at closing rate."
    },
    {
      "@id": "ek:DepreciationType",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Depreciation",
      "skos:definition": "Fixed-asset depreciation from the register."
    },
    {
      "@id": "ek:AmortizationType",
      "@type": [
        "owl:NamedIndividual",
        "ek:EntryType"
      ],
      "rdfs:label": "Amortisation",
      "skos:definition": "Prepaid amortisation from schedules."
    },
    {
      "@id": "ek:Existence",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Existence",
      "skos:definition": "Assets, liabilities and equity interests exist at the balance sheet date."
    },
    {
      "@id": "ek:Occurrence",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Occurrence",
      "skos:definition": "Recorded transactions and events have occurred and pertain to the entity."
    },
    {
      "@id": "ek:Completeness",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Completeness",
      "skos:definition": "All transactions and balances that should be recorded have been recorded."
    },
    {
      "@id": "ek:Accuracy",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Accuracy",
      "skos:definition": "Amounts and data have been recorded appropriately."
    },
    {
      "@id": "ek:Valuation",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Valuation & allocation",
      "skos:definition": "Balances are included at appropriate amounts and adjustments are recorded."
    },
    {
      "@id": "ek:Cutoff",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Cutoff",
      "skos:definition": "Transactions are recorded in the correct period."
    },
    {
      "@id": "ek:Classification",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Classification",
      "skos:definition": "Transactions are recorded in the proper accounts."
    },
    {
      "@id": "ek:RightsAndObligations",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Rights & obligations",
      "skos:definition": "The entity holds rights to assets and liabilities are its obligations."
    },
    {
      "@id": "ek:PresentationAndDisclosure",
      "@type": [
        "owl:NamedIndividual",
        "ek:Assertion"
      ],
      "rdfs:label": "Presentation & disclosure",
      "skos:definition": "Components are properly classified, described and disclosed."
    },
    {
      "@id": "ek:OverallMateriality",
      "@type": [
        "owl:NamedIndividual",
        "ek:Materiality"
      ],
      "rdfs:label": "Overall materiality",
      "skos:definition": "Threshold for the financial statements as a whole (e.g. 1% of revenue).",
      "ek:basis": "revenue",
      "ek:pct": 0.01
    },
    {
      "@id": "ek:PerformanceMateriality",
      "@type": [
        "owl:NamedIndividual",
        "ek:Materiality"
      ],
      "rdfs:label": "Performance materiality",
      "skos:definition": "Lower threshold used to reduce aggregation risk (typically 50–75% of overall).",
      "ek:pctOfOverall": 0.75
    },
    {
      "@id": "ek:ClearlyTrivial",
      "@type": [
        "owl:NamedIndividual",
        "ek:Materiality"
      ],
      "rdfs:label": "Clearly trivial",
      "skos:definition": "Threshold below which misstatements are clearly inconsequential (typically ≤5% of overall).",
      "ek:pctOfOverall": 0.05
    },
    {
      "@id": "ek:L0",
      "@type": [
        "owl:NamedIndividual",
        "ek:AutonomyLevel"
      ],
      "rdfs:label": "L0 — Suggest",
      "skos:definition": "Agent suggests; a person must act."
    },
    {
      "@id": "ek:L1",
      "@type": [
        "owl:NamedIndividual",
        "ek:AutonomyLevel"
      ],
      "rdfs:label": "L1 — Draft for approval",
      "skos:definition": "Agent drafts; every item needs approval before posting."
    },
    {
      "@id": "ek:L2",
      "@type": [
        "owl:NamedIndividual",
        "ek:AutonomyLevel"
      ],
      "rdfs:label": "L2 — Auto-post under threshold",
      "skos:definition": "Agent posts items below the policy threshold and confidence floor; a sample is reviewed after posting."
    },
    {
      "@id": "ek:L3",
      "@type": [
        "owl:NamedIndividual",
        "ek:AutonomyLevel"
      ],
      "rdfs:label": "L3 — Auto with post-hoc review",
      "skos:definition": "Agent posts verified items; all are reviewed after posting. Never above performance materiality."
    },
    {
      "@id": "ek:Spot",
      "@type": [
        "owl:NamedIndividual",
        "ek:RateType"
      ],
      "rdfs:label": "Spot rate",
      "skos:definition": "Rate on the transaction date."
    },
    {
      "@id": "ek:Closing",
      "@type": [
        "owl:NamedIndividual",
        "ek:RateType"
      ],
      "rdfs:label": "Closing rate",
      "skos:definition": "Rate at the balance sheet date; used for monetary items."
    },
    {
      "@id": "ek:Average",
      "@type": [
        "owl:NamedIndividual",
        "ek:RateType"
      ],
      "rdfs:label": "Average rate",
      "skos:definition": "Period average; used for income statement translation."
    },
    {
      "@id": "ek:Historical",
      "@type": [
        "owl:NamedIndividual",
        "ek:RateType"
      ],
      "rdfs:label": "Historical rate",
      "skos:definition": "Rate when the item arose; used for equity and non-monetary items."
    },
    {
      "@id": "ek:ControlEnvironment",
      "@type": [
        "owl:NamedIndividual",
        "ek:Control"
      ],
      "rdfs:label": "Control environment",
      "skos:definition": "COSO component 1 (principles 1–5)."
    },
    {
      "@id": "ek:RiskAssessment",
      "@type": [
        "owl:NamedIndividual",
        "ek:Control"
      ],
      "rdfs:label": "Risk assessment",
      "skos:definition": "COSO component 2 (principles 6–9)."
    },
    {
      "@id": "ek:ControlActivities",
      "@type": [
        "owl:NamedIndividual",
        "ek:Control"
      ],
      "rdfs:label": "Control activities",
      "skos:definition": "COSO component 3 (principles 10–12): approvals, reconciliations, SoD."
    },
    {
      "@id": "ek:InformationCommunication",
      "@type": [
        "owl:NamedIndividual",
        "ek:Control"
      ],
      "rdfs:label": "Information & communication",
      "skos:definition": "COSO component 4 (principles 13–15)."
    },
    {
      "@id": "ek:MonitoringActivities",
      "@type": [
        "owl:NamedIndividual",
        "ek:Control"
      ],
      "rdfs:label": "Monitoring activities",
      "skos:definition": "COSO component 5 (principles 16–17)."
    },
    {
      "@id": "ek:BalanceSheet",
      "@type": [
        "owl:NamedIndividual",
        "ek:FinancialStatement"
      ],
      "rdfs:label": "Balance sheet",
      "skos:definition": "Statement of financial position at a date."
    },
    {
      "@id": "ek:IncomeStatement",
      "@type": [
        "owl:NamedIndividual",
        "ek:FinancialStatement"
      ],
      "rdfs:label": "Income statement",
      "skos:definition": "Statement of operations for a period."
    },
    {
      "@id": "ek:CashFlowStatement",
      "@type": [
        "owl:NamedIndividual",
        "ek:FinancialStatement"
      ],
      "rdfs:label": "Cash flow statement",
      "skos:definition": "Statement of cash flows for a period."
    },
    {
      "@id": "ek:PriorMonth",
      "@type": [
        "owl:NamedIndividual",
        "ek:ComparisonBasis"
      ],
      "rdfs:label": "Prior month",
      "skos:definition": "Compare with the immediately preceding period."
    },
    {
      "@id": "ek:PriorYear",
      "@type": [
        "owl:NamedIndividual",
        "ek:ComparisonBasis"
      ],
      "rdfs:label": "Prior year",
      "skos:definition": "Compare with the same period last year (seasonality)."
    },
    {
      "@id": "ek:BudgetComparison",
      "@type": [
        "owl:NamedIndividual",
        "ek:ComparisonBasis"
      ],
      "rdfs:label": "Budget",
      "skos:definition": "Compare with the approved budget."
    },
    {
      "@id": "ek:axiom/AX-DE-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Debits equal credits",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∀ e ∈ JournalEntry: Σ_{l ∈ lines(e)} debit(l) = Σ_{l ∈ lines(e)} credit(l)",
      "rdfs:comment": "Every journal entry must balance: total debits equal total credits.",
      "dcterms:source": [
        {
          "@id": "cite:pacioli1494"
        },
        {
          "@id": "cite:ellerman1985"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-DE-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Each line is one-sided and positive",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∀ l ∈ lines(e): (debit(l) > 0 ∧ credit(l) = 0) ∨ (credit(l) > 0 ∧ debit(l) = 0); amounts ∈ ℤ",
      "rdfs:comment": "Each line is either a debit or a credit (not both, not zero), in whole cents.",
      "dcterms:source": [
        {
          "@id": "cite:pacioli1494"
        },
        {
          "@id": "cite:xbrl-gl"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-DE-03",
      "@type": "ek:Axiom",
      "rdfs:label": "At least one debit and one credit",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∃ l1, l2 ∈ lines(e): debit(l1) > 0 ∧ credit(l2) > 0",
      "rdfs:comment": "An entry needs at least one debit line and one credit line.",
      "dcterms:source": [
        {
          "@id": "cite:pacioli1494"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-DE-04",
      "@type": "ek:Axiom",
      "rdfs:label": "Single-currency entries balance in transaction currency",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "If all lines share txnCurrency k ≠ functional: Σ txnAmount(l) = 0",
      "rdfs:comment": "If every line is in the same foreign currency, the foreign amounts must also balance.",
      "dcterms:source": [
        {
          "@id": "cite:asc830"
        },
        {
          "@id": "cite:ellerman1985"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-DE-05",
      "@type": "ek:Axiom",
      "rdfs:label": "Accounting equation holds",
      "ek:appliesTo": {
        "@id": "ek:TrialBalance"
      },
      "ek:severity": "error",
      "ek:formal": "Σ debits = Σ credits over all accounts ⇔ Assets = Liabilities + Equity + (Revenue − Expenses)",
      "rdfs:comment": "The trial balance must net to zero: assets equal liabilities plus equity plus current-period profit.",
      "dcterms:source": [
        {
          "@id": "cite:pacioli1494"
        },
        {
          "@id": "cite:ellerman1985"
        },
        {
          "@id": "cite:con6"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-PER-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Posting requires an open period",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "state(period(e)) = Open ∨ (state = SoftClose ∧ type(e) ∈ AdjustingTypes ∧ role(actor) ≥ Senior)",
      "rdfs:comment": "You can only post into an open month. In soft close, only adjusting-type entries by a senior accountant or above.",
      "dcterms:source": [
        {
          "@id": "cite:isa315"
        },
        {
          "@id": "cite:coso2013"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-PER-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Entry date within its period",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "start(period(e)) ≤ date(e) ≤ end(period(e))",
      "rdfs:comment": "The entry date must fall inside the month it is posted to (cutoff).",
      "dcterms:source": [
        {
          "@id": "cite:isa315"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-ACC-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Lines post to active, postable accounts",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∀ l: account(l) ∈ Accounts(tenant) ∧ postable(account(l)) ∧ active(account(l))",
      "rdfs:comment": "Every line must use an existing, active, postable (non-summary) account.",
      "dcterms:source": [
        {
          "@id": "cite:xbrl-gl"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-ACC-03",
      "@type": "ek:Axiom",
      "rdfs:label": "Required dimensions present",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∀ l: requiresDepartment(account(l)) → department(l) ≠ ∅",
      "rdfs:comment": "Operating expense lines must say which department the cost belongs to.",
      "dcterms:source": [
        {
          "@id": "cite:xbrl-gl"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-ACC-04",
      "@type": "ek:Axiom",
      "rdfs:label": "Control accounts are posted through their subledger",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "warning",
      "ek:formal": "controlAccount(account(l)) ∧ source(e) ∈ {manual, agent} → flag",
      "rdfs:comment": "Manual entries straight to AP, AR or cash bypass the subledger and break tie-outs.",
      "dcterms:source": [
        {
          "@id": "cite:xbrl-gl"
        },
        {
          "@id": "cite:pcaob-as2401"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-FX-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Ledger is kept in functional currency",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "currency(e) = functionalCurrency(entity(e))",
      "rdfs:comment": "Each entity’s books are kept in its functional currency; foreign amounts are carried per line.",
      "dcterms:source": [
        {
          "@id": "cite:asc830"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-JE-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Reversals mirror the original",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "reverses(e, o) → posted(o) ∧ ¬reversed(o) ∧ entity(e)=entity(o) ∧ date(e) ≥ date(o) ∧ lines(e) = swap(lines(o))",
      "rdfs:comment": "A reversing entry must undo a posted, not-yet-reversed entry exactly, on or after its date.",
      "dcterms:source": [
        {
          "@id": "cite:pacioli1494"
        },
        {
          "@id": "cite:pcaob-as1105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-JE-03",
      "@type": "ek:Axiom",
      "rdfs:label": "Accruals auto-reverse next period",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "type(e) = Accrual → autoReverseDate(e) = start(period(e) + 1)",
      "rdfs:comment": "An accrual must be set to reverse on the first day of the next month, so it is not double counted when the bill arrives.",
      "dcterms:source": [
        {
          "@id": "cite:con6"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-JE-04",
      "@type": "ek:Axiom",
      "rdfs:label": "Eliminations only in the elimination entity",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "(type(e) = Elimination → entity(e) ∈ EliminationEntity) ∧ (entity(e) ∈ EliminationEntity → type(e) ∈ {Elimination, Reversing ∘ Elimination})",
      "rdfs:comment": "Elimination entries live only in the consolidation (elimination) entity, which holds nothing else apart from reversals of its own eliminations.",
      "dcterms:source": [
        {
          "@id": "cite:asc810"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-IC-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Intercompany lines name the counterparty",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "∀ l: intercompany(account(l)) → counterparty(l) ∈ Entities ∖ {entity(e)}",
      "rdfs:comment": "Lines on intercompany accounts must say which other group company they relate to.",
      "dcterms:source": [
        {
          "@id": "cite:asc810"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-SOD-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Preparer is not approver",
      "ek:appliesTo": {
        "@id": "ek:JournalEntry"
      },
      "ek:severity": "error",
      "ek:formal": "approvedBy(e) ≠ ∅ → approvedBy(e) ∉ {preparedBy(e), requestedBy(e)}",
      "rdfs:comment": "The person who prepared (or asked an agent to prepare) an entry cannot approve it.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        },
        {
          "@id": "cite:sox404"
        },
        {
          "@id": "cite:pcaob-as2201"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-REC-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Reconciliation ties out",
      "ek:appliesTo": {
        "@id": "ek:Reconciliation"
      },
      "ek:severity": "error",
      "ek:formal": "certified(r) → |GL(r) − (Statement(r) + Σ reconcilingItems(r))| ≤ tolerance ∧ unexplained(r) = 0",
      "rdfs:comment": "A reconciliation can only be certified when the ledger equals the statement after explained items, with nothing unexplained.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        },
        {
          "@id": "cite:pcaob-as1105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-REC-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Certified reconciliations carry evidence",
      "ek:appliesTo": {
        "@id": "ek:Reconciliation"
      },
      "ek:severity": "error",
      "ek:formal": "certified(r) → |evidence(r)| ≥ 1",
      "rdfs:comment": "Attach the statement or schedule that supports the balance before certifying.",
      "dcterms:source": [
        {
          "@id": "cite:pcaob-as1105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-REC-03",
      "@type": "ek:Axiom",
      "rdfs:label": "Reviewer is not the preparer",
      "ek:appliesTo": {
        "@id": "ek:Reconciliation"
      },
      "ek:severity": "error",
      "ek:formal": "reviewed(r) → reviewer(r) ≠ preparer(r)",
      "rdfs:comment": "Someone other than the preparer must review a reconciliation.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        },
        {
          "@id": "cite:sox404"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-REC-04",
      "@type": "ek:Axiom",
      "rdfs:label": "Reconciling items are not stale",
      "ek:appliesTo": {
        "@id": "ek:Reconciliation"
      },
      "ek:severity": "warning",
      "ek:formal": "∀ i ∈ items(r): age(i) ≤ 90 days",
      "rdfs:comment": "Reconciling items older than 90 days should be investigated or written off.",
      "dcterms:source": [
        {
          "@id": "cite:pcaob-as1105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-FLX-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Material variances are explained",
      "ek:appliesTo": {
        "@id": "ek:Variance"
      },
      "ek:severity": "error",
      "ek:formal": "material(v) → ∃ x ∈ VarianceExplanation: explains(x, v) ∧ approved(x)",
      "rdfs:comment": "Every variance above threshold needs an approved explanation before the close is signed off.",
      "dcterms:source": [
        {
          "@id": "cite:pcaob-as2201"
        },
        {
          "@id": "cite:isa315"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-FLX-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Explanations quantify most of the variance",
      "ek:appliesTo": {
        "@id": "ek:Variance"
      },
      "ek:severity": "warning",
      "ek:formal": "explains(x, v) → Σ drivers(x) / variance(v) ≥ 0.8",
      "rdfs:comment": "A good explanation puts numbers on at least 80% of the change.",
      "dcterms:source": [
        {
          "@id": "cite:pcaob-as2201"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-FLX-03",
      "@type": "ek:Axiom",
      "rdfs:label": "Explanation approver is not the author",
      "ek:appliesTo": {
        "@id": "ek:Variance"
      },
      "ek:severity": "error",
      "ek:formal": "approved(x) → approver(x) ≠ author(x)",
      "rdfs:comment": "Someone other than the author approves a flux explanation.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-IC-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Intercompany balances agree",
      "ek:appliesTo": {
        "@id": "ek:IntercompanyBalance"
      },
      "ek:severity": "error",
      "ek:formal": "|dueFrom(A,B) − dueTo(B,A)|_{reporting ccy} ≤ tolerance",
      "rdfs:comment": "What one group company says it is owed must equal what the other says it owes (after FX), before eliminating.",
      "dcterms:source": [
        {
          "@id": "cite:asc810"
        },
        {
          "@id": "cite:asc830"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-MAT-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Materiality levels are ordered",
      "ek:appliesTo": {
        "@id": "ek:Materiality"
      },
      "ek:severity": "error",
      "ek:formal": "0 < clearlyTrivial < performance ≤ overall",
      "rdfs:comment": "Clearly trivial must be smaller than performance materiality, which cannot exceed overall materiality.",
      "dcterms:source": [
        {
          "@id": "cite:isa320"
        },
        {
          "@id": "cite:isa450"
        },
        {
          "@id": "cite:pcaob-as2105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-CLS-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Task dependencies are acyclic",
      "ek:appliesTo": {
        "@id": "ek:CloseCycle"
      },
      "ek:severity": "error",
      "ek:formal": "dependsOn⁺ is irreflexive",
      "rdfs:comment": "Close tasks cannot depend on themselves, directly or through a chain.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-CLS-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Lock only a finished close",
      "ek:appliesTo": {
        "@id": "ek:FiscalPeriod"
      },
      "ek:severity": "error",
      "ek:formal": "lock(p) → tasks(p) complete ∧ recs(p) reviewed ∧ materialFlux(p) explained ∧ pendingProposals(p) = ∅ ∧ package(p) generated",
      "rdfs:comment": "A month can be locked only when every task is done, every reconciliation is reviewed, material variances are explained, nothing awaits approval and the close package exists.",
      "dcterms:source": [
        {
          "@id": "cite:coso2013"
        },
        {
          "@id": "cite:sox404"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-PRP-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Proposals explain themselves",
      "ek:appliesTo": {
        "@id": "ek:Proposal"
      },
      "ek:severity": "error",
      "ek:formal": "∀ p ∈ Proposal: |why(p)| > 0 ∧ |evidence(p)| ≥ 1 ∧ confidence(p) ∈ [0,1]",
      "rdfs:comment": "Every agent proposal says why in plain English, shows its evidence and states a confidence.",
      "dcterms:source": [
        {
          "@id": "cite:iso42001"
        },
        {
          "@id": "cite:pcaob-as1105"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-PRP-02",
      "@type": "ek:Axiom",
      "rdfs:label": "Autonomy ceiling",
      "ek:appliesTo": {
        "@id": "ek:AutonomyLevel"
      },
      "ek:severity": "error",
      "ek:formal": "autoPost(p) → level ∈ {L2,L3} ∧ |amount| < performanceMateriality ∧ (level = L3 ∨ (|amount| < threshold ∧ confidence ≥ floor))",
      "rdfs:comment": "Agents may only post on their own at L2/L3, never above performance materiality, and at L2 only under the threshold and above the confidence floor.",
      "dcterms:source": [
        {
          "@id": "cite:iso42001"
        },
        {
          "@id": "cite:isa320"
        },
        {
          "@id": "cite:coso2013"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-CAP-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Equipment above threshold is capitalised",
      "ek:appliesTo": {
        "@id": "ek:CodingDecision"
      },
      "ek:severity": "warning",
      "ek:formal": "concept(t) ⊑ ComputerEquipment ∧ unitCost(t) ≥ capThreshold → treatment(t) = capitalize",
      "rdfs:comment": "Equipment that costs more than the capitalisation threshold per unit should be recorded as a fixed asset, not an expense.",
      "dcterms:source": [
        {
          "@id": "cite:asc360"
        }
      ]
    },
    {
      "@id": "ek:axiom/AX-PPD-01",
      "@type": "ek:Axiom",
      "rdfs:label": "Multi-month prepayments are deferred",
      "ek:appliesTo": {
        "@id": "ek:CodingDecision"
      },
      "ek:severity": "warning",
      "ek:formal": "servicePeriodMonths(t) > 1 ∧ amount(t) ≥ prepaidThreshold → treatment(t) = prepaid",
      "rdfs:comment": "A payment that covers several future months should be recorded as a prepaid and spread over those months.",
      "dcterms:source": [
        {
          "@id": "cite:asc340"
        }
      ]
    },

{
  "name": "evenkeel",
  "version": "1.0.0",
  "private": true,
  "description": "Evenkeel: an agentic month-end close platform. Agents do the work; your team keeps control.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm install && npm run build:web",
    "start": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx src/server/main.ts",
    "dev:web": "vite --config vite.config.ts --mode server",
    "go": "npm run build:web && npm start",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "build": "npm run build:web && npm run build:demo",
    "build:web": "vite build --config vite.config.ts --mode server",
    "build:demo": "vite build --config vite.config.ts --mode demo",
    "preview:demo": "node scripts/static-serve.mjs dist-demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:integration": "node --import tsx scripts/with-postgres.ts vitest run --project integration",
    "evals": "node --import tsx scripts/run-evals.ts",
    "e2e": "npm run build && playwright test",
    "screenshots": "node --import tsx scripts/screenshots.ts",
    "ads": "node --import tsx scripts/render-ads.ts",
    "mcp": "node --import tsx src/mcp/main.ts",
    "ontology:export": "node --import tsx scripts/export-ontology.ts",
    "docs:erd": "node --import tsx scripts/export-erd.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run evals"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

# Evenkeel configuration. Copy to .env (never commit .env). Every value is optional.

# HTTP server
PORT=0                      # 0 = pick a free port and print it
HOST=127.0.0.1
PUBLIC_ORIGIN=              # e.g. https://close.example.com (enables Secure cookies + strict Origin checks)

# Database: leave empty to use the embedded PGlite (Postgres compiled to WASM) under .data/pglite
DATABASE_URL=               # e.g. postgres://evenkeel:<password>@127.0.0.1:5432/evenkeel

# Live agents: set to use Claude through the Anthropic API. Empty = deterministic offline engine.
ANTHROPIC_API_KEY=
EVENKEEL_MODEL_FAST=claude-haiku-5-5
EVENKEEL_MODEL_BALANCED=claude-sonnet-5-5
EVENKEEL_MODEL_DEEP=claude-opus-5-5

# Business clock for the seeded scenario. "scenario" pins "today" to WD+2 of the September 2026 close.
# Use "real" for wall-clock time.
EVENKEEL_CLOCK=scenario

# Demo users (development only). Leave empty to generate a strong random password per user at seed time;
# the generated credentials are written to .data/demo-credentials.json (gitignored) and printed once.
DEMO_PASSWORD=
# Show the demo-credentials helper on the login page (forced off when NODE_ENV=production)
DEMO_LOGIN_HELPER=1

# Session security
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Optional OIDC single sign-on seam (see docs/ASSESSMENT.md); not required for local use
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

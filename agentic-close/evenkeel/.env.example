# Evenkeel configuration. Copy to .env (never commit .env). Every value is optional.
# `npm start` and `npm run dev:server` read .env automatically when it exists.

# --- HTTP server
# 0 picks a free port. If PORT is unset and 4610 is busy, a free port is used and printed.
PORT=4610
HOST=127.0.0.1
# e.g. https://close.example.com (turns on Secure cookies, HSTS and strict Origin checks)
PUBLIC_ORIGIN=
# auto | true | false
COOKIE_SECURE=auto

# --- Database
# Empty = embedded PGlite (Postgres compiled to WebAssembly) under .data/pglite.
# Example: postgres://evenkeel:CHANGE_ME@127.0.0.1:5432/evenkeel
DATABASE_URL=
# Default ./.data (PGlite files, generated demo credentials, local secret key)
EVENKEEL_DATA_DIR=

# --- Secret key for TOTP secrets and CSRF tokens: 32 random bytes, base64.
# Empty = generate .data/secret.key on first start.
EVENKEEL_SECRET_KEY=

# --- Agents
# auto = live Claude when ANTHROPIC_API_KEY is set, otherwise the deterministic offline engine.
# auto | offline | live
EVENKEEL_ENGINE=auto
ANTHROPIC_API_KEY=
EVENKEEL_MODEL_FAST=claude-haiku-5-5
EVENKEEL_MODEL_BALANCED=claude-sonnet-5-5
EVENKEEL_MODEL_DEEP=claude-opus-5-5

# --- Business clock
# "scenario" pins "today" to WD+2 of the September 2026 close of the fictional Kitewell Labs;
# "system" uses wall-clock time.
EVENKEEL_CLOCK=scenario

# --- Demo users (development only; both settings are refused when NODE_ENV=production)
# Empty DEMO_PASSWORD = generate a strong random password per user at seed time, written to
# .data/demo-credentials.json (gitignored, mode 0600) and printed once.
DEMO_PASSWORD=
# 1 = list the demo accounts on the sign-in page (only for requests from this machine)
DEMO_LOGIN_HELPER=1

# --- Session security
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Optional OIDC single sign-on seam (see docs/ASSESSMENT.md); not required for local use
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=

# --- Automated tests only: multiply rate-limit budgets (must stay 1 in production)
RATE_LIMIT_SCALE=1

# --- Docker Compose only (compose.yaml): password for the bundled PostgreSQL 16 service,
# and the loopback port the app is published on.
POSTGRES_PASSWORD=
EVENKEEL_PORT=4610

{
  "name": "tieout",
  "version": "1.0.0",
  "private": true,
  "description": "Tieout: the agentic month-end close platform. Agents prepare, people sign off.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "tsx scripts/dev.ts",
    "start": "npm run build:web && tsx src/server/node.ts",
    "start:prod": "node dist/server/node.js",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsx scripts/build-server.ts",
    "build:demo": "vite build --config vite.demo.config.ts && tsx scripts/verify-demo-build.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "gen": "tsx scripts/gen-bundles.ts",
    "gen:check": "tsx scripts/gen-bundles.ts --check",
    "ontology:export": "tsx scripts/export-ontology.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "evals": "tsx scripts/run-evals.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:demo": "npm run build:demo && playwright test --config playwright.demo.config.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "ads": "tsx scripts/render-ads.ts",
    "mcp": "tsx src/mcp/main.ts",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run gen:check && npm run typecheck && npm run lint && npm test && npm run evals"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

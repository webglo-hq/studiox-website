    },
    {
      "@id": "https://tieout.example/ontology/close#scheduledOn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "due on",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#CloseTask"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Workday"
      },
      "skos:definition": "Workday offset the task is due.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#performedBySkill",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "performed by skill",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#CloseTask"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Skill"
      },
      "skos:definition": "Agent skill bound to a task.",
      "tie:cardinality": "0..1"
    },
    {
      "@id": "https://tieout.example/ontology/close#blockedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "blocked by",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#CloseTask"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Blocker"
      },
      "skos:definition": "Open items preventing completion.",
      "tie:cardinality": "0..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#produces",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "produces",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#FinancialClose"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#ClosePackage"
      },
      "skos:definition": "A close ends in a signed package.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#runsSkill",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "runs",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#AgentRun"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Skill"
      },
      "skos:definition": "Skill executed by a run.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#onBehalfOf",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "on behalf of",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#SoftwareAgent"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#InternalAgent"
      },
      "skos:definition": "Person accountable for an agent run.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#hasStep",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "has step",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#AgentRun"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#AgentStep"
      },
      "skos:definition": "Ordered steps of a run.",
      "tie:cardinality": "1..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#invokes",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "invokes",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#AgentStep"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#ToolCall"
      },
      "skos:definition": "Typed tool calls in a step.",
      "tie:cardinality": "0..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#proposes",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "proposes",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#AgentRun"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Proposal"
      },
      "skos:definition": "Proposals produced by a run.",
      "tie:cardinality": "0..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#governedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "governed by",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#Skill"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#SkillPolicy"
      },
      "skos:definition": "Customer-set policy constraining a skill.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#atAutonomy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "at autonomy",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#SkillPolicy"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#AutonomyLevel"
      },
      "skos:definition": "Autonomy level granted.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#scoredBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "scored by",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#Proposal"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#ConfidenceScore"
      },
      "skos:definition": "Confidence attached to a proposal.",
      "tie:cardinality": "1"
    },
    {
      "@id": "https://tieout.example/ontology/close#verifiedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "verified by",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#Proposal"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#Verification"
      },
      "skos:definition": "Deterministic checks a proposal passed.",
      "tie:cardinality": "1..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#flaggedFor",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "flagged for",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#SourceDocument"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#PromptInjection"
      },
      "skos:definition": "Untrusted content detected as instruction-like.",
      "tie:cardinality": "0..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#hasObligation",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "has obligation",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#ContractWithCustomer"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#PerformanceObligation"
      },
      "skos:definition": "Distinct promises in a contract (ASC 606 step 2).",
      "tie:cardinality": "1..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#allocates",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "allocates",
      "rdfs:domain": {
        "@id": "https://tieout.example/ontology/close#TransactionPrice"
      },
      "rdfs:range": {
        "@id": "https://tieout.example/ontology/close#PerformanceObligation"
      },
      "skos:definition": "Price allocation by standalone selling price (step 4).",
      "tie:cardinality": "1..*"
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-DE-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Entries balance",
      "tie:formal": "∀e ∈ JournalEntry: Σ_{l ∈ lines(e)} debit(l) = Σ_{l ∈ lines(e)} credit(l) > 0",
      "skos:definition": "Total debits equal total credits, and the entry moves some money.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pacioli1494"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_ellerman2014"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_xbrl-gl"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-DE-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Lines are one-sided and positive",
      "tie:formal": "∀l ∈ JournalLine: (debit(l) > 0 ∧ credit(l) = 0) ∨ (credit(l) > 0 ∧ debit(l) = 0)",
      "skos:definition": "Each line is either a debit or a credit, never both, never zero, never negative.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalLine"
        },
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_xbrl-gl"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-DE-03",
      "@type": "tie:Axiom",
      "rdfs:label": "At least two lines",
      "tie:formal": "∀e ∈ JournalEntry: |lines(e)| ≥ 2",
      "skos:definition": "An entry needs at least one debit line and one credit line (REA duality).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_mccarthy1982"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_pacioli1494"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-DE-04",
      "@type": "tie:Axiom",
      "rdfs:label": "Trial balance balances",
      "tie:formal": "Σ_{a ∈ Accounts} debitBalance(a) = Σ_{a ∈ Accounts} creditBalance(a)",
      "skos:definition": "Across the whole ledger, debit balances equal credit balances — so Assets = Liabilities + Equity.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#TrialBalance"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pacioli1494"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_conceptual-framework"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-IM-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Posted entries are immutable",
      "tie:formal": "∀e: status(e) = posted ⇒ □¬modified(e); corrections ≔ ∃r ∈ ReversingEntry: reverses(r, e)",
      "skos:definition": "Once posted, an entry never changes. Mistakes are fixed by posting a reversing entry (and, if needed, a corrected one).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc250"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-IM-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Reverse posted entries only, once",
      "tie:formal": "∀r ∈ ReversingEntry: status(reversed(r)) = posted ∧ |{r′ : reverses(r′, reversed(r))}| = 1",
      "skos:definition": "Only a posted entry can be reversed, and only one reversal may exist for it.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#ReversingEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc250"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-PD-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Post only into open periods",
      "tie:formal": "post(e) ⇒ status(period(e)) = open ∨ (status(period(e)) = soft_closed ∧ type(e) ∈ AdjustingEntry)",
      "skos:definition": "Open periods take everything; soft-closed periods take approved adjustments only; locked periods take nothing.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-PD-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Posting date inside its period",
      "tie:formal": "start(period(e)) ≤ postingDate(e) ≤ end(period(e))",
      "skos:definition": "The posting date must fall inside the period the entry posts to (cut-off).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_aicpa-auc315"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-PD-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Period lifecycle",
      "tie:formal": "transitions ⊆ {future→open, open→soft_closed, soft_closed→open, soft_closed→locked, locked→soft_closed[reason]}",
      "skos:definition": "Periods move future → open → soft-closed → locked. Re-opening a locked period needs a documented reason.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#AccountingPeriod"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AC-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Post to active leaf accounts",
      "tie:formal": "∀l: postsTo(l, a) ⇒ postable(a) ∧ active(a)",
      "skos:definition": "Lines can only post to active accounts that are leaves of the chart (not summary headers).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalLine"
        },
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_xbrl-gl"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AC-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Required dimensions present",
      "tie:formal": "∀l, d: d ∈ requiredDimensions(account(l)) ⇒ ∃v: taggedWith(l, d, v)",
      "skos:definition": "If an account requires a department (or other dimension), every line posting to it must carry one.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalLine"
        },
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_xbrl-gl"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AC-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Normal balance follows class",
      "tie:formal": "normal(a) = debit ⇔ (class(a) ∈ {Asset, Expense}) ⊕ contra(a)",
      "skos:definition": "Assets and expenses are debit-normal, liabilities, equity and revenue credit-normal; contra accounts flip it.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Account"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pacioli1494"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_conceptual-framework"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AC-04",
      "@type": "tie:Axiom",
      "rdfs:label": "Control accounts via subledger or reclass",
      "tie:formal": "postsTo(l, a) ∧ control(a) ∧ source(e) ∉ {subledger} ⇒ type(e) = reclass ∧ approverRole(e) ≥ Controller",
      "skos:definition": "Manual or agent entries that touch AP, AR or other control accounts are only allowed as reclasses and escalate to a Controller.",
      "tie:severity": "warning",
      "tie:enforcedBy": [
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#ControlAccount"
        },
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SOD-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Maker-checker",
      "tie:formal": "∀x: approvedBy(x) ≠ preparedBy(x) ∧ approvedBy(x) ≠ editedBy(x)",
      "skos:definition": "Nobody approves their own work — including work they edited.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database",
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        },
        {
          "@id": "https://tieout.example/ontology/close#Proposal"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as2201"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SOD-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Agent requester is not the checker",
      "tie:formal": "enabled(SOD-02) ∧ proposedBy(p) ∈ SoftwareAgent ⇒ approvedBy(p) ≠ onBehalfOf(run(p))",
      "skos:definition": "Whoever asked an agent to draft entries cannot also approve them — the agent works for them, so it is their work.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntryProposal"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_nist-ai-rmf"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SOD-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Reconciliation preparer ≠ reviewer",
      "tie:formal": "∀r ∈ Reconciliation: reviewer(r) ≠ preparer(r)",
      "skos:definition": "The person (or the person behind the agent) who prepared a reconciliation cannot also review it.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Reconciliation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as2201"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SOD-04",
      "@type": "tie:Axiom",
      "rdfs:label": "Within approval limit",
      "tie:formal": "approve(u, x) ⇒ amount(x) ≤ approvalLimit(role(u))",
      "skos:definition": "You can only approve amounts within your role’s approval limit; larger items escalate.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#JournalEntry"
        },
        {
          "@id": "https://tieout.example/ontology/close#Proposal"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-REC-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Reconciliation ties out",
      "tie:formal": "external(r) + Σ_{i ∈ items, side=external} amt(i) − (gl(r) + Σ_{i ∈ items, side=ledger} amt(i)) ∈ [−τ, τ]",
      "skos:definition": "After adding the reconciling items to each side, the bank (or subledger) and the ledger agree to within tolerance.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Reconciliation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-REC-02",
      "@type": "tie:Axiom",
      "rdfs:label": "One match per item",
      "tie:formal": "∀x: |{m ∈ confirmedMatches : x ∈ items(m)}| ≤ 1",
      "skos:definition": "A bank line or ledger line can be matched only once.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#ReconciliationMatch"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-REC-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Matches net to zero",
      "tie:formal": "|Σ external(m) − Σ ledger(m)| ≤ τ",
      "skos:definition": "The two sides of a match must add up to the same amount (within the policy tolerance).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#ReconciliationMatch"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-REC-04",
      "@type": "tie:Axiom",
      "rdfs:label": "No certification with unexplained differences",
      "tie:formal": "certify(r) ⇒ Σ |unexplained(r)| = 0 ∨ justified(r)",
      "skos:definition": "A reconciliation with an unexplained difference can only be signed off with a written justification and follow-up.",
      "tie:severity": "warning",
      "tie:enforcedBy": [
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Reconciliation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-ACR-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Accruals auto-reverse next period",
      "tie:formal": "∀e ∈ AccrualEntry: autoReverseOn(e) = start(next(period(e)))",
      "skos:definition": "An accrual reverses on day one of the next period, so the real invoice can post without double counting.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#AccrualEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_conceptual-framework"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-ACR-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Accruals are evidenced",
      "tie:formal": "∀p ∈ AccrualEntryProposal: ∃ev ∈ evidence(p): kind(ev) ∈ {purchase order & receipt, recurring pattern, subsequent invoice, payroll calendar}",
      "skos:definition": "Every proposed accrual cites its basis: a received purchase order, a recurring vendor pattern, a later invoice, or the payroll calendar.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#AccrualEntryProposal"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as1105"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_asc450"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SCH-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Schedules allocate exactly",
      "tie:formal": "Σ amount(lines(s)) = total(s) ∧ periods(lines(s)) distinct",
      "skos:definition": "A schedule’s monthly amounts add up to the total, and each month appears once.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#PrepaidSchedule"
        },
        {
          "@id": "https://tieout.example/ontology/close#DepreciationSchedule"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc340"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_asc360"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SCH-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Depreciation bounded by depreciable base",
      "tie:formal": "accumulatedDepreciation(a) ≤ cost(a) − salvage(a)",
      "skos:definition": "You cannot depreciate an asset below its salvage value.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#FixedAsset"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc360"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-SCH-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Capitalization threshold",
      "tie:formal": "cost(x) ≥ θ_cap ∧ usefulLife(x) > 12 ⇒ capitalized(x)",
      "skos:definition": "Single purchases above the capitalization threshold with a multi-year life belong on the balance sheet, not in expense.",
      "tie:severity": "warning",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#PropertyPlantEquipment"
        },
        {
          "@id": "https://tieout.example/ontology/close#CapitalizationPolicy"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc360"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-IC-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Intercompany balances agree",
      "tie:formal": "|receivable(A,B) − payable(B,A)|_{reporting ccy} ≤ τ_fx",
      "skos:definition": "What one entity says another owes it must equal what the other says it owes, after currency conversion (allowing a small FX tolerance).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#IntercompanyBalance"
        },
        {
          "@id": "https://tieout.example/ontology/close#IntercompanyReconciliation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc810"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-IC-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Eliminations touch only intercompany accounts",
      "tie:formal": "∀e ∈ EliminationEntry, l ∈ lines(e): intercompany(account(l))",
      "skos:definition": "Elimination entries only remove intercompany balances and revenue/expense — nothing else.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#EliminationEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc810"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-FX-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Monetary items at closing rate",
      "tie:formal": "carrying_fc(m) = round(amount_tc(m) × closingRate(period))",
      "skos:definition": "Foreign-currency cash, receivables and payables are carried at the period-end exchange rate; the change is an unrealized FX gain or loss.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#MonetaryItem"
        },
        {
          "@id": "https://tieout.example/ontology/close#FxRevaluationEntry"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc830"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-FX-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Translation rates by item",
      "tie:formal": "translate(asset ∨ liability) @ closing; translate(revenue ∨ expense) @ average; translate(equity) @ historical; Δ → CTA",
      "skos:definition": "Balance sheet at the closing rate, income statement at the average rate, equity at historical rates; the plug is the cumulative translation adjustment.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Translation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_asc830"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-FLX-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Significant variances are explained",
      "tie:formal": "∀v ∈ lines(analysis): |Δ(v)| ≥ θ_abs ∧ |Δ%(v)| ≥ θ_pct ⇒ ∃x ∈ VarianceExplanation: approved(x) ∧ explains(x, v)",
      "skos:definition": "Every variance over both thresholds needs an approved explanation before the period can be locked.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#VarianceAnalysis"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as2105"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-FLX-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Drivers reconcile to the variance",
      "tie:formal": "|Σ amount(drivers(x)) − Δ(v)| ≤ max(0.10 · |Δ(v)|, 100)",
      "skos:definition": "The drivers cited in an explanation add up to the variance within 10%.",
      "tie:severity": "warning",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#VarianceExplanation"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as2105"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-MAT-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Materiality ordering",
      "tie:formal": "0 < CT < PM < OM",
      "skos:definition": "Clearly trivial < performance materiality < overall materiality.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Materiality"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_aicpa-auc320"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_aicpa-auc450"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_isa320"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-CL-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Dependencies first",
      "tie:formal": "done(t) ⇒ ∀d: dependsOn(t, d) ⇒ done(d) ∨ skipped(d)",
      "skos:definition": "A task can’t be signed off before the tasks it depends on (preparation can start early).",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#CloseTask"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_apqc-close"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-CL-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Lock only a finished close",
      "tie:formal": "lock(p) ⇒ pending(p) = ∅ ∧ ∀r ∈ recs(p): reviewed(r) ∧ AX-FLX-01(p) ∧ ∃ final ClosePackage(p)",
      "skos:definition": "A period locks only when there are no pending proposals above clearly trivial, every reconciliation is reviewed, significant variances are explained and a close package exists.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime",
        "ui"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#LockedPeriod"
        },
        {
          "@id": "https://tieout.example/ontology/close#FinancialClose"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_coso2013"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AGT-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Proposals are explained",
      "tie:formal": "∀p ∈ Proposal: |why(p)| ≥ 12 ∧ 0 ≤ confidence(p) ≤ 1 ∧ |evidence(p)| ≥ 1",
      "skos:definition": "Every agent proposal says why in plain English, carries a confidence between 0 and 1, and cites evidence.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "ontology",
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Proposal"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_nist-ai-rmf"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_iso42001"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AGT-02",
      "@type": "tie:Axiom",
      "rdfs:label": "Untrusted text never steers agents",
      "tie:formal": "derivedFrom(p, d) ∧ flaggedFor(d, PromptInjection) ⇒ route(p) ∈ {suggestion, human_approval}",
      "skos:definition": "If a proposal is based on data containing instruction-like text, it can never auto-post; a person must look.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#Proposal"
        },
        {
          "@id": "https://tieout.example/ontology/close#PromptInjection"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_owasp-llm"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AGT-03",
      "@type": "tie:Axiom",
      "rdfs:label": "Agents cannot approve or post",
      "tie:formal": "∀t ∈ tools(agent): effect(t) ∈ {read, propose}",
      "skos:definition": "An agent’s tools can read and propose; approving, posting and paying are human (or Controller-signed policy) actions.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#SoftwareAgent"
        },
        {
          "@id": "https://tieout.example/ontology/close#ToolCall"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_owasp-llm"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_nist-ai-rmf"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#AX-AUD-01",
      "@type": "tie:Axiom",
      "rdfs:label": "Audit trail is append-only and hash-chained",
      "tie:formal": "∀n > 1: hash(n) = SHA256(hash(n−1) ‖ canon(event(n))) ∧ □¬(update ∨ delete)",
      "skos:definition": "Audit events can only be appended; each one seals the previous, so any later edit is detectable.",
      "tie:severity": "error",
      "tie:enforcedBy": [
        "database",
        "runtime"
      ],
      "tie:executable": true,
      "tie:appliesTo": [
        {
          "@id": "https://tieout.example/ontology/close#AuditTrail"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://tieout.example/ontology/close#cite_sox404"
        },
        {
          "@id": "https://tieout.example/ontology/close#cite_pcaob-as2201"
        }
      ]
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_mccarthy1982",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "McCarthy (1982), The REA Accounting Model",
      "dcterms:bibliographicCitation": "McCarthy, W. E. (1982). The REA Accounting Model: A Generalized Framework for Accounting Systems in a Shared Data Environment. The Accounting Review, 57(3), 554–578.",
      "tie:kind": "paper",
      "foaf:page": {
        "@id": "https://www.jstor.org/stable/246878"
      }
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_geerts2002",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "Geerts & McCarthy (2002), extended-REA ontology",
      "dcterms:bibliographicCitation": "Geerts, G. L., & McCarthy, W. E. (2002). An ontological analysis of the economic primitives of the extended-REA enterprise information architecture. International Journal of Accounting Information Systems, 3(1), 1–16.",
      "tie:kind": "paper"
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_iso15944-4",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "ISO/IEC 15944-4 (REA accounting & economic ontology)",
      "dcterms:bibliographicCitation": "ISO/IEC 15944-4:2015. Information technology — Business operational view — Part 4: Business transaction scenarios — Accounting and economic ontology.",
      "tie:kind": "standard"
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_pacioli1494",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "Pacioli (1494), Particularis de computis",
      "dcterms:bibliographicCitation": "Pacioli, L. (1494). Summa de arithmetica, geometria, proportioni et proportionalita — Particularis de computis et scripturis. Venice.",
      "tie:kind": "book"
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_ellerman2014",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "Ellerman (2014), double-entry as algebra",
      "dcterms:bibliographicCitation": "Ellerman, D. (2014). On Double-Entry Bookkeeping: The Mathematical Treatment. Accounting Education, 23(5), 483–501.",
      "tie:kind": "paper",
      "foaf:page": {
        "@id": "https://doi.org/10.1080/09639284.2014.949810"
      }
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_xbrl-gl",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "XBRL Global Ledger Taxonomy (XBRL GL)",
      "dcterms:bibliographicCitation": "XBRL International. XBRL Global Ledger Taxonomy Framework (gl-cor, gl-bus, gl-muc, gl-usk), Recommendation 2016-12-01.",
      "tie:kind": "taxonomy",
      "foaf:page": {
        "@id": "https://specifications.xbrl.org/work-product-index-gl-gl-1.0.html"
      }
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_usgaap-taxonomy",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "FASB US GAAP Financial Reporting Taxonomy",
      "dcterms:bibliographicCitation": "Financial Accounting Standards Board. US GAAP Financial Reporting Taxonomy (2026 release).",
      "tie:kind": "taxonomy",
      "foaf:page": {
        "@id": "https://www.fasb.org/xbrl"
      }
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_fibo",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "EDM Council FIBO",
      "dcterms:bibliographicCitation": "EDM Council / OMG. Financial Industry Business Ontology (FIBO): Foundations (FND) and Business Entities (BE) domains.",
      "tie:kind": "taxonomy",
      "foaf:page": {
        "@id": "https://spec.edmcouncil.org/fibo/"
      }
    },
    {
      "@id": "https://tieout.example/ontology/close#cite_coso2013",
      "@type": "dcterms:BibliographicResource",
      "dcterms:title": "COSO Internal Control—Integrated Framework (2013)",

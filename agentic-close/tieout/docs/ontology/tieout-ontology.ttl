  skos:definition "Open items preventing completion."@en .

tie:produces a owl:ObjectProperty ;
  rdfs:label "produces"@en ;
  rdfs:domain tie:FinancialClose ;
  rdfs:range tie:ClosePackage ;
  skos:definition "A close ends in a signed package."@en .

tie:runsSkill a owl:ObjectProperty ;
  rdfs:label "runs"@en ;
  rdfs:domain tie:AgentRun ;
  rdfs:range tie:Skill ;
  skos:definition "Skill executed by a run."@en .

tie:onBehalfOf a owl:ObjectProperty ;
  rdfs:label "on behalf of"@en ;
  rdfs:domain tie:SoftwareAgent ;

tie:taskOf a owl:ObjectProperty ;
  rdfs:label "task of"@en ;
  rdfs:domain tie:CloseTask ;
  rdfs:range tie:FinancialClose ;
  skos:definition "Tasks belong to one period close."@en .

tie:dependsOn a owl:ObjectProperty ;
  rdfs:label "depends on"@en ;
  rdfs:domain tie:CloseTask ;
  rdfs:range tie:CloseTask ;
  skos:definition "A task cannot finish before its prerequisites."@en .

tie:scheduledOn a owl:ObjectProperty ;
  rdfs:label "due on"@en ;

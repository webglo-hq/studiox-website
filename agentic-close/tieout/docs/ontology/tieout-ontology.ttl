tie:allocates a owl:ObjectProperty ;
  rdfs:label "allocates"@en ;
  rdfs:domain tie:TransactionPrice ;
  rdfs:range tie:PerformanceObligation ;
  skos:definition "Price allocation by standalone selling price (step 4)."@en .

tie:AX_DE_01 a tie:Axiom ;
  rdfs:label "Entries balance"@en ;
  tie:formal "∀e ∈ JournalEntry: Σ_{l ∈ lines(e)} debit(l) = Σ_{l ∈ lines(e)} credit(l) > 0" ;
  skos:definition "Total debits equal total credits, and the entry moves some money."@en .

tie:AX_DE_02 a tie:Axiom ;
  rdfs:label "Lines are one-sided and positive"@en ;
  tie:formal "∀l ∈ JournalLine: (debit(l) > 0 ∧ credit(l) = 0) ∨ (credit(l) > 0 ∧ debit(l) = 0)" ;
  skos:definition "Each line is either a debit or a credit, never both, never zero, never negative."@en .

tie:AX_DE_03 a tie:Axiom ;
  rdfs:label "At least two lines"@en ;
  tie:formal "∀e ∈ JournalEntry: |lines(e)| ≥ 2" ;
  skos:definition "An entry needs at least one debit line and one credit line (REA duality)."@en .

tie:AX_DE_04 a tie:Axiom ;
  rdfs:label "Trial balance balances"@en ;
  tie:formal "Σ_{a ∈ Accounts} debitBalance(a) = Σ_{a ∈ Accounts} creditBalance(a)" ;
  skos:definition "Across the whole ledger, debit balances equal credit balances — so Assets = Liabilities + Equity."@en .

tie:AX_FS_01 a tie:Axiom ;
  rdfs:label "Income statement ties to the ledger"@en ;
  tie:formal "∀e, p: netIncome(IS(e, p)) = −Σ_{l ∈ lines(e, p), class(account(l)) ∈ {revenue, expense}, type(entry(l)) ≠ closing} (debit(l) − credit(l))" ;
  skos:definition "Net income on every income statement equals the income and expenses posted in the ledger for that period (year-end closing entries excluded). Presentation may regroup amounts, never change the total."@en .

tie:AX_IM_01 a tie:Axiom ;
  rdfs:label "Posted entries are immutable"@en ;
  tie:formal "∀e: status(e) = posted ⇒ □¬modified(e); corrections ≔ ∃r ∈ ReversingEntry: reverses(r, e)" ;
  skos:definition "Once posted, an entry never changes. Mistakes are fixed by posting a reversing entry (and, if needed, a corrected one)."@en .

tie:AX_IM_02 a tie:Axiom ;
  rdfs:label "Reverse posted entries only, once"@en ;
  tie:formal "∀r ∈ ReversingEntry: status(reversed(r)) = posted ∧ |{r′ : reverses(r′, reversed(r))}| = 1" ;
  skos:definition "Only a posted entry can be reversed, and only one reversal may exist for it."@en .

tie:AX_PD_01 a tie:Axiom ;
  rdfs:label "Post only into open periods"@en ;
  tie:formal "post(e) ⇒ status(period(e)) = open ∨ (status(period(e)) = soft_closed ∧ type(e) ∈ AdjustingEntry)" ;
  skos:definition "Open periods take everything; soft-closed periods take approved adjustments only; locked periods take nothing."@en .

tie:AX_PD_02 a tie:Axiom ;
  rdfs:label "Posting date inside its period"@en ;
  tie:formal "start(period(e)) ≤ postingDate(e) ≤ end(period(e))" ;
  skos:definition "The posting date must fall inside the period the entry posts to (cut-off)."@en .

tie:AX_PD_03 a tie:Axiom ;
  rdfs:label "Period lifecycle"@en ;
  tie:formal "transitions ⊆ {future→open, open→soft_closed, soft_closed→open, soft_closed→locked, locked→soft_closed[reason]}" ;
  skos:definition "Periods move future → open → soft-closed → locked. Re-opening a locked period needs a documented reason."@en .

tie:AX_AC_01 a tie:Axiom ;
  rdfs:label "Post to active leaf accounts"@en ;
  tie:formal "∀l: postsTo(l, a) ⇒ postable(a) ∧ active(a)" ;
  skos:definition "Lines can only post to active accounts that are leaves of the chart (not summary headers)."@en .

tie:AX_AC_02 a tie:Axiom ;
  rdfs:label "Required dimensions present"@en ;
  tie:formal "∀l, d: d ∈ requiredDimensions(account(l)) ⇒ ∃v: taggedWith(l, d, v)" ;
  skos:definition "If an account requires a department (or other dimension), every line posting to it must carry one."@en .

tie:AX_AC_03 a tie:Axiom ;
  rdfs:label "Normal balance follows class"@en ;
  tie:formal "normal(a) = debit ⇔ (class(a) ∈ {Asset, Expense}) ⊕ contra(a)" ;
  skos:definition "Assets and expenses are debit-normal, liabilities, equity and revenue credit-normal; contra accounts flip it."@en .

tie:AX_AC_04 a tie:Axiom ;
  rdfs:label "Control accounts via subledger or reclass"@en ;
  tie:formal "postsTo(l, a) ∧ control(a) ∧ source(e) ∉ {subledger} ⇒ type(e) = reclass ∧ approverRole(e) ≥ Controller" ;
  skos:definition "Manual or agent entries that touch AP, AR or other control accounts are only allowed as reclasses and escalate to a Controller."@en .

tie:AX_SOD_01 a tie:Axiom ;
  rdfs:label "Maker-checker"@en ;
  tie:formal "∀x: approvedBy(x) ≠ preparedBy(x) ∧ approvedBy(x) ≠ editedBy(x)" ;
  skos:definition "Nobody approves their own work — including work they edited."@en .

tie:AX_SOD_02 a tie:Axiom ;
  rdfs:label "Agent requester is not the checker"@en ;
  tie:formal "enabled(SOD-02) ∧ proposedBy(p) ∈ SoftwareAgent ⇒ approvedBy(p) ≠ onBehalfOf(run(p))" ;
  skos:definition "Whoever asked an agent to draft entries cannot also approve them — the agent works for them, so it is their work."@en .

tie:AX_SOD_03 a tie:Axiom ;
  rdfs:label "Reconciliation preparer ≠ reviewer"@en ;
  tie:formal "∀r ∈ Reconciliation: reviewer(r) ≠ preparer(r)" ;
  skos:definition "The person (or the person behind the agent) who prepared a reconciliation cannot also review it."@en .

tie:AX_SOD_04 a tie:Axiom ;
  rdfs:label "Within approval limit"@en ;
  tie:formal "approve(u, x) ⇒ amount(x) ≤ approvalLimit(role(u))" ;
  skos:definition "You can only approve amounts within your role’s approval limit; larger items escalate."@en .

tie:AX_REC_01 a tie:Axiom ;
  rdfs:label "Reconciliation ties out"@en ;
  tie:formal "external(r) + Σ_{i ∈ items, side=external} amt(i) − (gl(r) + Σ_{i ∈ items, side=ledger} amt(i)) ∈ [−τ, τ]" ;
  skos:definition "After adding the reconciling items to each side, the bank (or subledger) and the ledger agree to within tolerance."@en .

tie:AX_REC_02 a tie:Axiom ;
  rdfs:label "One match per item"@en ;
  tie:formal "∀x: |{m ∈ confirmedMatches : x ∈ items(m)}| ≤ 1" ;
  skos:definition "A bank line or ledger line can be matched only once."@en .

tie:AX_REC_03 a tie:Axiom ;
  rdfs:label "Matches net to zero"@en ;
  tie:formal "|Σ external(m) − Σ ledger(m)| ≤ τ" ;
  skos:definition "The two sides of a match must add up to the same amount (within the policy tolerance)."@en .

tie:AX_REC_04 a tie:Axiom ;
  rdfs:label "No certification with unexplained differences"@en ;
  tie:formal "certify(r) ⇒ Σ |unexplained(r)| = 0 ∨ justified(r)" ;
  skos:definition "A reconciliation with an unexplained difference can only be signed off with a written justification and follow-up."@en .

tie:AX_ACR_01 a tie:Axiom ;
  rdfs:label "Accruals auto-reverse next period"@en ;
  tie:formal "∀e ∈ AccrualEntry: autoReverseOn(e) = start(next(period(e)))" ;
  skos:definition "An accrual reverses on day one of the next period, so the real invoice can post without double counting."@en .

tie:AX_ACR_02 a tie:Axiom ;
  rdfs:label "Accruals are evidenced"@en ;
  tie:formal "∀p ∈ AccrualEntryProposal: ∃ev ∈ evidence(p): kind(ev) ∈ {purchase order & receipt, recurring pattern, subsequent invoice, payroll calendar}" ;
  skos:definition "Every proposed accrual cites its basis: a received purchase order, a recurring vendor pattern, a later invoice, or the payroll calendar."@en .

tie:AX_SCH_01 a tie:Axiom ;
  rdfs:label "Schedules allocate exactly"@en ;
  tie:formal "Σ amount(lines(s)) = total(s) ∧ periods(lines(s)) distinct" ;
  skos:definition "A schedule’s monthly amounts add up to the total, and each month appears once."@en .

tie:AX_SCH_02 a tie:Axiom ;
  rdfs:label "Depreciation bounded by depreciable base"@en ;
  tie:formal "accumulatedDepreciation(a) ≤ cost(a) − salvage(a)" ;
  skos:definition "You cannot depreciate an asset below its salvage value."@en .

tie:AX_SCH_03 a tie:Axiom ;
  rdfs:label "Capitalization threshold"@en ;
  tie:formal "cost(x) ≥ θ_cap ∧ usefulLife(x) > 12 ⇒ capitalized(x)" ;
  skos:definition "Single purchases above the capitalization threshold with a multi-year life belong on the balance sheet, not in expense."@en .

tie:AX_IC_01 a tie:Axiom ;
  rdfs:label "Intercompany balances agree"@en ;
  tie:formal "|receivable(A,B) − payable(B,A)|_{reporting ccy} ≤ τ_fx" ;
  skos:definition "What one entity says another owes it must equal what the other says it owes, after currency conversion (allowing a small FX tolerance)."@en .

tie:AX_IC_02 a tie:Axiom ;
  rdfs:label "Eliminations touch only intercompany accounts"@en ;
  tie:formal "∀e ∈ EliminationEntry, l ∈ lines(e): intercompany(account(l))" ;
  skos:definition "Elimination entries only remove intercompany balances and revenue/expense — nothing else."@en .

tie:AX_FX_01 a tie:Axiom ;
  rdfs:label "Monetary items at closing rate"@en ;
  tie:formal "carrying_fc(m) = round(amount_tc(m) × closingRate(period))" ;
  skos:definition "Foreign-currency cash, receivables and payables are carried at the period-end exchange rate; the change is an unrealized FX gain or loss."@en .

tie:AX_FX_02 a tie:Axiom ;
  rdfs:label "Translation rates by item"@en ;
  tie:formal "translate(asset ∨ liability) @ closing; translate(revenue ∨ expense) @ average; translate(equity) @ historical; Δ → CTA" ;
  skos:definition "Balance sheet at the closing rate, income statement at the average rate, equity at historical rates; the plug is the cumulative translation adjustment."@en .

tie:AX_FLX_01 a tie:Axiom ;
  rdfs:label "Significant variances are explained"@en ;
  tie:formal "∀v ∈ lines(analysis): |Δ(v)| ≥ θ_abs ∧ |Δ%(v)| ≥ θ_pct ⇒ ∃x ∈ VarianceExplanation: approved(x) ∧ covers(x) = (current(v), comparative(v))" ;
  skos:definition "Every variance over both thresholds needs an approved explanation of the variance as it stands before the period can be locked. A later posting that moves the figures puts the explanation out of date."@en .

tie:AX_FLX_02 a tie:Axiom ;
  rdfs:label "Drivers reconcile to the variance"@en ;
  tie:formal "|Σ amount(drivers(x)) − Δ(v)| ≤ max(0.10 · |Δ(v)|, 100)" ;
  skos:definition "The drivers cited in an explanation add up to the variance within 10%."@en .

tie:AX_MAT_01 a tie:Axiom ;
  rdfs:label "Materiality ordering"@en ;
  tie:formal "0 < CT < PM < OM" ;
  skos:definition "Clearly trivial < performance materiality < overall materiality."@en .

tie:AX_CL_01 a tie:Axiom ;
  rdfs:label "Dependencies first"@en ;
  tie:formal "done(t) ⇒ ∀d: dependsOn(t, d) ⇒ done(d) ∨ skipped(d)" ;
  skos:definition "A task can’t be signed off before the tasks it depends on (preparation can start early)."@en .

tie:AX_CL_02 a tie:Axiom ;
  rdfs:label "Lock only a finished close"@en ;
  tie:formal "lock(p) ⇒ pending(p) = ∅ ∧ ∀r ∈ recs(p): reviewed(r) ∧ AX-FLX-01(p) ∧ AX-FS-01(p) ∧ ∃ final ClosePackage(p) matching the ledger and the current explanations" ;
  skos:definition "A period locks only when there are no pending proposals above clearly trivial, every reconciliation is reviewed, significant variances are explained, every income statement ties to the ledger and an approved close package still matches the books."@en .

tie:AX_AGT_01 a tie:Axiom ;
  rdfs:label "Proposals are explained"@en ;
  tie:formal "∀p ∈ Proposal: |why(p)| ≥ 12 ∧ 0 ≤ confidence(p) ≤ 1 ∧ |evidence(p)| ≥ 1" ;
  skos:definition "Every agent proposal says why in plain English, carries a confidence between 0 and 1, and cites evidence."@en .

tie:AX_AGT_02 a tie:Axiom ;
  rdfs:label "Untrusted text never steers agents"@en ;
  tie:formal "derivedFrom(p, d) ∧ flaggedFor(d, PromptInjection) ⇒ route(p) ∈ {suggestion, human_approval}" ;
  skos:definition "If a proposal is based on data containing instruction-like text, it can never auto-post; a person must look."@en .

tie:AX_AGT_03 a tie:Axiom ;
  rdfs:label "Agents cannot approve or post"@en ;
  tie:formal "∀t ∈ tools(agent): effect(t) ∈ {read, propose}" ;
  skos:definition "An agent’s tools can read and propose; approving, posting and paying are human (or Controller-signed policy) actions."@en .

tie:AX_AUD_01 a tie:Axiom ;
  rdfs:label "Audit trail is append-only and hash-chained"@en ;
  tie:formal "∀n > 1: hash(n) = SHA256(hash(n−1) ‖ canon(event(n))) ∧ □¬(update ∨ delete)" ;
  skos:definition "Audit events can only be appended; each one seals the previous, so any later edit is detectable."@en .

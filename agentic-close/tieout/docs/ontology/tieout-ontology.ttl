tie:hasStep a owl:ObjectProperty ;
  rdfs:label "has step"@en ;
  rdfs:domain tie:AgentRun ;
  rdfs:range tie:AgentStep ;
  skos:definition "Ordered steps of a run."@en .

tie:invokes a owl:ObjectProperty ;
  rdfs:label "invokes"@en ;
  rdfs:domain tie:AgentStep ;
  rdfs:range tie:ToolCall ;
  skos:definition "Typed tool calls in a step."@en .

tie:proposes a owl:ObjectProperty ;
  rdfs:label "proposes"@en ;
  rdfs:domain tie:AgentRun ;
  rdfs:range tie:Proposal ;
  skos:definition "Proposals produced by a run."@en .

tie:governedBy a owl:ObjectProperty ;
  rdfs:label "governed by"@en ;
  rdfs:domain tie:Skill ;
  rdfs:range tie:SkillPolicy ;
  skos:definition "Customer-set policy constraining a skill."@en .

tie:atAutonomy a owl:ObjectProperty ;
  rdfs:label "at autonomy"@en ;
  rdfs:domain tie:SkillPolicy ;
  rdfs:range tie:AutonomyLevel ;
  skos:definition "Autonomy level granted."@en .

tie:scoredBy a owl:ObjectProperty ;
  rdfs:label "scored by"@en ;
  rdfs:domain tie:Proposal ;
  rdfs:range tie:ConfidenceScore ;
  skos:definition "Confidence attached to a proposal."@en .

tie:verifiedBy a owl:ObjectProperty ;
  rdfs:label "verified by"@en ;
  rdfs:domain tie:Proposal ;
  rdfs:range tie:Verification ;
  skos:definition "Deterministic checks a proposal passed."@en .

tie:flaggedFor a owl:ObjectProperty ;
  rdfs:label "flagged for"@en ;
  rdfs:domain tie:SourceDocument ;
  rdfs:range tie:PromptInjection ;
  skos:definition "Untrusted content detected as instruction-like."@en .

tie:hasObligation a owl:ObjectProperty ;
  rdfs:label "has obligation"@en ;
  rdfs:domain tie:ContractWithCustomer ;
  rdfs:range tie:PerformanceObligation ;

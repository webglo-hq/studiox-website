# Copy to .env (never commit .env). Every value has a safe local default.

# HTTP. PORT=0 picks a random free port; set e.g. 4310 for a fixed one.
PORT=0
HOST=127.0.0.1
# Public origin, e.g. https://close.example.com. Enables strict Origin checks and Secure cookies.
PUBLIC_ORIGIN=

# Database. Leave DATABASE_URL empty to use embedded Postgres (PGlite) in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Live LLM mode. Leave empty to use the deterministic offline agent engine.
ANTHROPIC_API_KEY=

# Demo seeding for the fictional company. When DEMO_PASSWORD is empty the dev-only
# default documented in README.md is used (never use it outside local development).
SEED_DEMO=true
DEMO_PASSWORD=

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Optional OIDC single sign-on (seam; see docs/ASSESSMENT.md)
OIDC_ISSUER=
OIDC_CLIENT_ID=

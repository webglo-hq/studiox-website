# Copy to .env (never commit .env). Every value has a safe local default.

# HTTP. PORT=0 picks a random free port; set e.g. 4310 for a fixed one.
PORT=0
HOST=127.0.0.1
# Public origin, e.g. https://close.example.com. Enables strict Origin checks and Secure cookies.
PUBLIC_ORIGIN=
# Force Secure cookies on or off (default: on when PUBLIC_ORIGIN is https).
SECURE_COOKIES=
# Honour X-Forwarded-For / X-Real-IP for rate limits only when behind your own reverse proxy.
TRUST_PROXY=false

# Database. Leave DATABASE_URL empty to use embedded Postgres (PGlite) in PGLITE_DIR.
# In production use an ordinary (non-superuser) role so row-level security applies.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# STORE=memory runs without any database (data is lost on restart).
STORE=

# 32 random bytes, base64 (encrypts MFA secrets at rest). Generated into .data/ for local dev when empty.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Live LLM mode. Leave empty to use the deterministic offline agent engine.
ANTHROPIC_API_KEY=

# Demo seeding for the fictional company. When DEMO_PASSWORD is empty the dev-only
# default documented in README.md is used (never use it outside local development).
SEED_DEMO=true
DEMO_PASSWORD=
# The demo runs on a scenario clock (WD+2 of the September 2026 close). Set to "system" for real time.
DEMO_CLOCK=

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Optional OIDC single sign-on (seam; see docs/ASSESSMENT.md)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=

# MCP server (npm run mcp): a running Tieout and a personal API token (Admin > My account)
TIEOUT_URL=
TIEOUT_API_TOKEN=

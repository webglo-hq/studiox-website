    },
    {
      "@id": "bh:fromConnector",
      "@type": "owl:ObjectProperty",
      "label": "from connector",
      "domain": "bh:ImportBatch",
      "range": "bh:Connector",
      "definition": "Connector that delivered the file."
    },
    {
      "@id": "bh:hasProvenance",
      "@type": "owl:ObjectProperty",
      "label": "has provenance",
      "domain": "bh:BankTransaction",
      "range": "bh:Provenance",
      "definition": "Where the record came from."
    },
    {
      "@id": "bh:Asset",
      "@type": [
        "owl:NamedIndividual",
        "bh:AccountClass"
      ],
      "label": "Asset",
      "definition": "Probable future economic benefit controlled by the entity."
    },
    {
      "@id": "bh:Liability",
      "@type": [
        "owl:NamedIndividual",
        "bh:AccountClass"
      ],
      "label": "Liability",
      "definition": "Present obligation to transfer economic benefits."
    },
    {
      "@id": "bh:Equity",
      "@type": [
        "owl:NamedIndividual",
        "bh:AccountClass"
      ],
      "label": "Equity",
      "definition": "Residual interest in assets after deducting liabilities."
    },
    {
      "@id": "bh:Revenue",
      "@type": [
        "owl:NamedIndividual",
        "bh:AccountClass"
      ],
      "label": "Revenue",
      "definition": "Inflows from delivering goods or services."
    },
    {
      "@id": "bh:Expense",
      "@type": [
        "owl:NamedIndividual",
        "bh:AccountClass"
      ],
      "label": "Expense",
      "definition": "Outflows or using up of assets to deliver goods or services."
    },
    {
      "@id": "bh:DebitNormal",
      "@type": [
        "owl:NamedIndividual",
        "bh:NormalBalance"
      ],
      "label": "Debit-normal",
      "definition": "Increases with debits: assets and expenses."
    },
    {
      "@id": "bh:CreditNormal",
      "@type": [
        "owl:NamedIndividual",
        "bh:NormalBalance"
      ],
      "label": "Credit-normal",
      "definition": "Increases with credits: liabilities, equity, revenue, contra-assets."
    },
    {
      "@id": "bh:PeriodFuture",
      "@type": [
        "owl:NamedIndividual",
        "bh:PeriodState"
      ],
      "label": "Future",
      "definition": "Not yet open; no postings."
    },
    {
      "@id": "bh:PeriodOpen",
      "@type": [
        "owl:NamedIndividual",
        "bh:PeriodState"
      ],
      "label": "Open",
      "definition": "Accepts all entry types."
    },
    {
      "@id": "bh:PeriodSoftClosed",
      "@type": [
        "owl:NamedIndividual",
        "bh:PeriodState"
      ],
      "label": "Soft-closed",
      "definition": "Subledgers frozen; only adjusting-type entries allowed."
    },
    {
      "@id": "bh:PeriodLocked",
      "@type": [
        "owl:NamedIndividual",
        "bh:PeriodState"
      ],
      "label": "Locked",
      "definition": "Hard-closed; no postings at all."
    },
    {
      "@id": "bh:StatusDraft",
      "@type": [
        "owl:NamedIndividual",
        "bh:PostingStatus"
      ],
      "label": "Draft",
      "definition": "Being prepared; not in balances."
    },
    {
      "@id": "bh:StatusPendingApproval",
      "@type": [
        "owl:NamedIndividual",
        "bh:PostingStatus"
      ],
      "label": "Pending approval",
      "definition": "Submitted; waiting for an independent approver."
    },
    {
      "@id": "bh:StatusPosted",
      "@type": [
        "owl:NamedIndividual",
        "bh:PostingStatus"
      ],
      "label": "Posted",
      "definition": "In the ledger; immutable."
    },
    {
      "@id": "bh:StatusRejected",
      "@type": [
        "owl:NamedIndividual",
        "bh:PostingStatus"
      ],
      "label": "Rejected",
      "definition": "Declined by a reviewer with a reason."
    },
    {
      "@id": "bh:ExistenceOccurrence",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Existence / occurrence",
      "definition": "Recorded assets and liabilities exist, and recorded transactions actually happened."
    },
    {
      "@id": "bh:Completeness",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Completeness",
      "definition": "Everything that should be recorded is recorded."
    },
    {
      "@id": "bh:AccuracyValuation",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Accuracy / valuation",
      "definition": "Amounts are recorded correctly and balances are valued appropriately."
    },
    {
      "@id": "bh:Cutoff",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Cutoff",
      "definition": "Transactions are recorded in the correct period."
    },
    {
      "@id": "bh:Classification",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Classification",
      "definition": "Transactions are recorded in the proper accounts."
    },
    {
      "@id": "bh:RightsObligations",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Rights and obligations",
      "definition": "The entity holds rights to its assets and its liabilities are its obligations."
    },
    {
      "@id": "bh:PresentationDisclosure",
      "@type": [
        "owl:NamedIndividual",
        "bh:AuditAssertion"
      ],
      "label": "Presentation and disclosure",
      "definition": "Items are properly presented, classified and described in the statements."
    },
    {
      "@id": "bh:OverallMateriality",
      "@type": [
        "owl:NamedIndividual",
        "bh:Materiality"
      ],
      "label": "Overall materiality",
      "definition": "The largest misstatement in the statements as a whole that would not change a reasonable user's decisions (often 0.5-1% of revenue or 5% of pre-tax income)."
    },
    {
      "@id": "bh:PerformanceMateriality",
      "@type": [
        "owl:NamedIndividual",
        "bh:Materiality"
      ],
      "label": "Performance materiality",
      "definition": "A lower threshold (typically 50-75% of overall) used for individual accounts so that undetected errors in total stay below overall materiality."
    },
    {
      "@id": "bh:ClearlyTrivial",
      "@type": [
        "owl:NamedIndividual",
        "bh:Materiality"
      ],
      "label": "Clearly trivial",
      "definition": "An amount so small that misstatements below it need not be accumulated (typically 3-5% of overall)."
    },
    {
      "@id": "bh:L0",
      "@type": [
        "owl:NamedIndividual",
        "bh:AutonomyLevel"
      ],
      "label": "L0 - Suggest",
      "definition": "The agent only suggests; a person must adopt the suggestion, which then goes through normal maker-checker."
    },
    {
      "@id": "bh:L1",
      "@type": [
        "owl:NamedIndividual",
        "bh:AutonomyLevel"
      ],
      "label": "L1 - Draft for approval",
      "definition": "The agent drafts; every proposal needs an independent approver before posting."
    },
    {
      "@id": "bh:L2",
      "@type": [
        "owl:NamedIndividual",
        "bh:AutonomyLevel"
      ],
      "label": "L2 - Auto-post under threshold",
      "definition": "Verified proposals under the amount threshold and above the confidence bar post automatically; a random sample is queued for post-hoc review; the rest need approval."
    },
    {
      "@id": "bh:L3",
      "@type": [
        "owl:NamedIndividual",
        "bh:AutonomyLevel"
      ],
      "label": "L3 - Auto with post-hoc review",
      "definition": "Verified proposals below the materiality cap post automatically and all are reviewed afterwards."
    },
    {
      "@id": "bh:SpotRate",
      "@type": [
        "owl:NamedIndividual",
        "bh:ExchangeRate"
      ],
      "label": "Spot rate",
      "definition": "The rate on the transaction date."
    },
    {
      "@id": "bh:AverageRate",
      "@type": [
        "owl:NamedIndividual",
        "bh:ExchangeRate"
      ],
      "label": "Average rate",
      "definition": "The average rate for the period."
    },
    {
      "@id": "bh:ClosingRate",
      "@type": [
        "owl:NamedIndividual",
        "bh:ExchangeRate"
      ],
      "label": "Closing rate",
      "definition": "The rate at period end."
    },
    {
      "@id": "bh:MatchExact",
      "@type": [
        "owl:NamedIndividual",
        "bh:MatchType"
      ],
      "label": "Exact",
      "definition": "Same amount and reference (or same amount and date) on both sides."
    },
    {
      "@id": "bh:MatchFuzzy",
      "@type": [
        "owl:NamedIndividual",
        "bh:MatchType"
      ],
      "label": "Fuzzy",
      "definition": "Same amount within tolerance and similar description, dates within a window."
    },
    {
      "@id": "bh:MatchOneToMany",
      "@type": [
        "owl:NamedIndividual",
        "bh:MatchType"
      ],
      "label": "One-to-many",
      "definition": "One external item matches several ledger items."
    },
    {
      "@id": "bh:MatchManyToOne",
      "@type": [
        "owl:NamedIndividual",
        "bh:MatchType"
      ],
      "label": "Many-to-one",
      "definition": "Several external items match one ledger item."
    },
    {
      "@id": "bh:MatchManual",
      "@type": [
        "owl:NamedIndividual",
        "bh:MatchType"
      ],
      "label": "Manual",
      "definition": "Matched by a person."
    },
    {
      "@id": "bh:ControlEnvironment",
      "@type": [
        "owl:NamedIndividual",
        "bh:Control"
      ],
      "label": "Control environment",
      "definition": "COSO component: integrity, ethics, oversight and structure."
    },
    {
      "@id": "bh:RiskAssessment",
      "@type": [
        "owl:NamedIndividual",
        "bh:Control"
      ],
      "label": "Risk assessment",
      "definition": "COSO component: identifying and analyzing risks to reliable reporting."
    },
    {
      "@id": "bh:ControlActivities",
      "@type": [
        "owl:NamedIndividual",
        "bh:Control"
      ],
      "label": "Control activities",
      "definition": "COSO component: policies and procedures that mitigate risks (approvals, reconciliations, SoD)."
    },
    {
      "@id": "bh:InformationCommunication",
      "@type": [
        "owl:NamedIndividual",
        "bh:Control"
      ],
      "label": "Information and communication",
      "definition": "COSO component: quality information flowing to the right people."
    },
    {
      "@id": "bh:MonitoringActivities",
      "@type": [
        "owl:NamedIndividual",
        "bh:Control"
      ],
      "label": "Monitoring activities",
      "definition": "COSO component: ongoing evaluation of whether controls work."
    },
    {
      "@id": "bh:JE_standard",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Standard",
      "definition": "Routine entry recording a business transaction."
    },
    {
      "@id": "bh:JE_adjusting",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Adjusting",
      "definition": "End-of-period correction or adjustment under accrual accounting."
    },
    {
      "@id": "bh:JE_accrual",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Accrual",
      "definition": "Recognizes an incurred expense or earned revenue before invoice or cash; auto-reverses next period."
    },
    {
      "@id": "bh:JE_reversing",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Reversing",
      "definition": "Undoes a prior entry by mirroring its lines."
    },
    {
      "@id": "bh:JE_recurring",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Recurring",
      "definition": "Generated each period from a template."
    },
    {
      "@id": "bh:JE_reclass",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Reclass",
      "definition": "Moves an amount between accounts or dimensions."
    },
    {
      "@id": "bh:JE_elimination",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Elimination",
      "definition": "Consolidation entry removing intercompany activity."
    },
    {
      "@id": "bh:JE_revaluation",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Revaluation",
      "definition": "Remeasures foreign-currency monetary balances at the closing rate."
    },
    {
      "@id": "bh:JE_depreciation",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Depreciation",
      "definition": "Monthly depreciation from the fixed-asset schedule."
    },
    {
      "@id": "bh:JE_amortization",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Amortization",
      "definition": "Monthly release of prepaid or deferred balances."
    },
    {
      "@id": "bh:JE_opening",
      "@type": [
        "owl:NamedIndividual",
        "bh:JournalEntryType"
      ],
      "label": "Opening balance",
      "definition": "Brings forward balances when books are first set up."
    },
    {
      "@id": "bh:FS_BS_CA_CASH",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Cash and cash equivalents",
      "definition": "Balance sheet line in \"Current assets\", mapped to us-gaap:CashAndCashEquivalentsAtCarryingValue."
    },
    {
      "@id": "bh:FS_BS_CA_AR",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Accounts receivable, net",
      "definition": "Balance sheet line in \"Current assets\", mapped to us-gaap:AccountsReceivableNetCurrent."
    },
    {
      "@id": "bh:FS_BS_CA_PREPAID",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Prepaid expenses",
      "definition": "Balance sheet line in \"Current assets\", mapped to us-gaap:PrepaidExpenseCurrent."
    },
    {
      "@id": "bh:FS_BS_CA_OTHER",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Other current assets",
      "definition": "Balance sheet line in \"Current assets\", mapped to us-gaap:OtherAssetsCurrent."
    },
    {
      "@id": "bh:FS_BS_CA_IC",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Due from affiliates",
      "definition": "Balance sheet line in \"Current assets\", mapped to us-gaap:DueFromRelatedPartiesCurrent."
    },
    {
      "@id": "bh:FS_BS_NCA_PPE",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Property and equipment, net",
      "definition": "Balance sheet line in \"Non-current assets\", mapped to us-gaap:PropertyPlantAndEquipmentNet."
    },
    {
      "@id": "bh:FS_BS_NCA_OTHER",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Other non-current assets",
      "definition": "Balance sheet line in \"Non-current assets\", mapped to us-gaap:OtherAssetsNoncurrent."
    },
    {
      "@id": "bh:FS_BS_CL_AP",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Accounts payable",
      "definition": "Balance sheet line in \"Current liabilities\", mapped to us-gaap:AccountsPayableCurrent."
    },
    {
      "@id": "bh:FS_BS_CL_ACCRUED",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Accrued liabilities",
      "definition": "Balance sheet line in \"Current liabilities\", mapped to us-gaap:AccruedLiabilitiesCurrent."
    },
    {
      "@id": "bh:FS_BS_CL_CARDS",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Credit card payable",
      "definition": "Balance sheet line in \"Current liabilities\", mapped to us-gaap:AccountsPayableCurrent."
    },
    {
      "@id": "bh:FS_BS_CL_DEFREV",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Deferred revenue",
      "definition": "Balance sheet line in \"Current liabilities\", mapped to us-gaap:ContractWithCustomerLiabilityCurrent."
    },
    {
      "@id": "bh:FS_BS_CL_IC",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Due to affiliates",
      "definition": "Balance sheet line in \"Current liabilities\", mapped to us-gaap:DueToRelatedPartiesCurrent."
    },
    {
      "@id": "bh:FS_BS_EQ_CAPITAL",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Common stock and paid-in capital",
      "definition": "Balance sheet line in \"Equity\", mapped to us-gaap:CommonStocksIncludingAdditionalPaidInCapital."
    },
    {
      "@id": "bh:FS_BS_EQ_RE",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Retained earnings",
      "definition": "Balance sheet line in \"Equity\", mapped to us-gaap:RetainedEarningsAccumulatedDeficit."
    },
    {
      "@id": "bh:FS_BS_EQ_AOCI",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Accumulated other comprehensive income",
      "definition": "Balance sheet line in \"Equity\", mapped to us-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax."
    },
    {
      "@id": "bh:FS_IS_REV_SUBSCRIPTION",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Subscription revenue",
      "definition": "Income statement line in \"Revenue\", mapped to us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax."
    },
    {
      "@id": "bh:FS_IS_REV_SERVICES",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Services revenue",
      "definition": "Income statement line in \"Revenue\", mapped to us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax."
    },
    {
      "@id": "bh:FS_IS_COGS",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Cost of revenue",
      "definition": "Income statement line in \"Cost of revenue\", mapped to us-gaap:CostOfRevenue."
    },
    {
      "@id": "bh:FS_IS_OPEX_PAYROLL",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Payroll and benefits",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:LaborAndRelatedExpense."
    },
    {
      "@id": "bh:FS_IS_OPEX_SOFTWARE",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Software subscriptions",
      "definition": "Income statement line in \"Operating expenses\"."
    },
    {
      "@id": "bh:FS_IS_OPEX_FACILITIES",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Rent and facilities",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:OccupancyNet."
    },
    {
      "@id": "bh:FS_IS_OPEX_TE",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Travel and entertainment",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:TravelAndEntertainmentExpense."
    },
    {
      "@id": "bh:FS_IS_OPEX_MARKETING",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Marketing and events",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:MarketingAndAdvertisingExpense."
    },
    {
      "@id": "bh:FS_IS_OPEX_PROF",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Professional fees",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:ProfessionalFees."
    },
    {
      "@id": "bh:FS_IS_OPEX_DA",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Depreciation and amortization",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:DepreciationDepletionAndAmortization."
    },
    {
      "@id": "bh:FS_IS_OPEX_OTHER",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Other operating expenses",
      "definition": "Income statement line in \"Operating expenses\", mapped to us-gaap:OtherCostAndExpenseOperating."
    },
    {
      "@id": "bh:FS_IS_IC",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Intercompany (eliminated)",
      "definition": "Income statement line in \"Intercompany\"."
    },
    {
      "@id": "bh:FS_IS_OTHER",
      "@type": [
        "owl:NamedIndividual",
        "bh:FinancialStatementLine"
      ],
      "label": "Other income (expense), net",
      "definition": "Income statement line in \"Other income (expense)\", mapped to us-gaap:NonoperatingIncomeExpense."
    },
    {
      "@id": "bh:AX-DE-01",
      "@type": "bh:Axiom",
      "label": "Double-entry balance",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall e in JournalEntry: sum(debit(l) | l in lines(e)) = sum(credit(l) | l in lines(e)) > 0",
      "definition": "Total debits must equal total credits, and the entry must move some money.",
      "severity": "error",
      "assertions": [
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-DE-02",
      "@type": "bh:Axiom",
      "label": "One-sided positive lines",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l in lines(e): (debit(l) > 0 xor credit(l) > 0) and debit(l) >= 0 and credit(l) >= 0",
      "definition": "Each line is either a debit or a credit, with a positive amount.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-DE-03",
      "@type": "bh:Axiom",
      "label": "At least two lines",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall e in JournalEntry: |lines(e)| >= 2",
      "definition": "An entry needs at least two lines: something debited and something credited.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-DE-04",
      "@type": "bh:Axiom",
      "label": "Post only to active leaf accounts",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l in lines(e): account(l) in PostableAccount and active(account(l))",
      "definition": "Lines may only post to accounts that exist, are active and are not header (summary) accounts.",
      "severity": "error",
      "assertions": [
        "classification"
      ]
    },
    {
      "@id": "bh:AX-PER-01",
      "@type": "bh:Axiom",
      "label": "Entry date inside its period",
      "appliesTo": "bh:JournalEntry",
      "formal": "start(period(e)) <= date(e) <= end(period(e)) and entity(period(e)) = entity(e)",
      "definition": "The accounting date must fall inside the period the entry posts to (cutoff).",
      "severity": "error",
      "assertions": [
        "cutoff"
      ]
    },
    {
      "@id": "bh:AX-PER-02",
      "@type": "bh:Axiom",
      "label": "Period must accept postings",
      "appliesTo": "bh:JournalEntry",
      "formal": "state(period(e)) = open or (state(period(e)) = soft_closed and type(e) in AdjustingTypes)",
      "definition": "Locked and future periods accept nothing; soft-closed periods accept only adjusting-type entries.",
      "severity": "error",
      "assertions": [
        "cutoff"
      ]
    },
    {
      "@id": "bh:AX-ACR-01",
      "@type": "bh:Axiom",
      "label": "Accruals auto-reverse next period",
      "appliesTo": "bh:JournalEntry",
      "formal": "type(e) = accrual -> auto_reverse_date(e) in next_period(period(e))",
      "definition": "Every accrual must schedule its reversal inside the next period, so the real invoice is not double counted.",
      "severity": "error",
      "assertions": [
        "cutoff",
        "completeness"
      ]
    },
    {
      "@id": "bh:AX-IC-01",
      "@type": "bh:Axiom",
      "label": "Intercompany lines name a counterparty",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l: intercompany(account(l)) -> counterparty(l) != null and counterparty(l) != entity(e)",
      "definition": "Lines on intercompany accounts must say which other group entity they are with (and not the same entity).",
      "severity": "error",
      "assertions": [
        "presentation_disclosure"
      ]
    },
    {
      "@id": "bh:AX-DIM-01",
      "@type": "bh:Axiom",
      "label": "Department required on budgeted spend",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l: requires_department(account(l)) -> department(l) != null",
      "definition": "Lines on operating-expense accounts must carry a department so budget owners see their spend.",
      "severity": "warning",
      "assertions": [
        "classification"
      ]
    },
    {
      "@id": "bh:AX-FX-01",
      "@type": "bh:Axiom",
      "label": "Foreign-currency lines convert at the stated rate",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l: currency(l) != functional(e) -> |functional_amount(l) - round(txn_amount(l) * rate(e))| <= 1",
      "definition": "When a line is in a foreign currency, its functional-currency amount must equal the transaction amount times the rate (to the cent).",
      "severity": "error",
      "assertions": [
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-CTL-01",
      "@type": "bh:Axiom",
      "label": "Maker-checker",
      "appliesTo": "bh:JournalEntry",
      "formal": "approver(e) != null -> approver(e) != preparer(e)",
      "definition": "Nobody approves their own entry.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-CAP-01",
      "@type": "bh:Axiom",
      "label": "Capitalize qualifying purchases",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l: expense(account(l)) and debit(l) >= cap_threshold and matches(memo(l), Capitalizable) -> warn",
      "definition": "A large debit to an expense account that looks like equipment or build-out probably belongs in property and equipment.",
      "severity": "warning",
      "assertions": [
        "classification"
      ]
    },
    {
      "@id": "bh:AX-RC-01",
      "@type": "bh:Axiom",
      "label": "Revenue entries carry a source",
      "appliesTo": "bh:JournalEntry",
      "formal": "forall l: revenue(account(l)) and type(e) in {standard, adjusting} -> description(e) != \"\"",
      "definition": "Manual entries that touch revenue must say what they are for; unexplained revenue entries are a fraud-risk indicator (AS 2401).",
      "severity": "warning",
      "assertions": [
        "existence_occurrence"
      ]
    },
    {
      "@id": "bh:AX-TB-01",
      "@type": "bh:Axiom",
      "label": "Trial balance balances",
      "appliesTo": "bh:TrialBalance",
      "formal": "sum(debit balances) = sum(credit balances)",
      "definition": "Across all accounts, total debit balances equal total credit balances.",
      "severity": "error",
      "assertions": [
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-TB-02",
      "@type": "bh:Axiom",
      "label": "Accounting equation",
      "appliesTo": "bh:TrialBalance",
      "formal": "assets = liabilities + equity + (revenue - expenses)",
      "definition": "Assets equal liabilities plus equity plus this year's profit.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-NB-01",
      "@type": "bh:Axiom",
      "label": "Balances on their normal side",
      "appliesTo": "bh:TrialBalance",
      "formal": "forall a: normal(a) = debit -> balance(a) >= 0; normal(a) = credit -> balance(a) <= 0",
      "definition": "An account sitting on its abnormal side (credit cash, debit payables) is usually an error worth a look.",
      "severity": "warning",
      "assertions": [
        "presentation_disclosure",
        "classification"
      ]
    },
    {
      "@id": "bh:AX-REC-01",
      "@type": "bh:Axiom",
      "label": "Reconciliation equation",
      "appliesTo": "bh:Reconciliation",
      "formal": "unexplained = gl - external - sum(reconciling_items); certify -> |unexplained| <= clearly_trivial",
      "definition": "GL balance minus the external balance minus reconciling items is the unexplained difference; it must be within the clearly-trivial threshold to certify.",
      "severity": "error",
      "assertions": [
        "existence_occurrence",
        "completeness",
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-REC-02",
      "@type": "bh:Axiom",
      "label": "Stale reconciling items",
      "appliesTo": "bh:Reconciliation",
      "formal": "forall i in open_items(r): age(i) <= stale_days",
      "definition": "Timing differences should clear within weeks; old open items are probably errors.",
      "severity": "warning"
    },
    {
      "@id": "bh:AX-REC-03",
      "@type": "bh:Axiom",
      "label": "Independent certification",
      "appliesTo": "bh:Reconciliation",
      "formal": "reviewer(r) != null -> reviewer(r) != preparer(r)",
      "definition": "A reconciliation is reviewed by someone other than its preparer.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-FLX-01",
      "@type": "bh:Axiom",
      "label": "Material variances are explained",
      "appliesTo": "bh:FluxAnalysis",
      "formal": "approved(f) -> forall line: material(line) -> explanation_status(line) = accepted",
      "definition": "Every variance above threshold needs an accepted explanation before the flux review is approved.",
      "severity": "error",
      "assertions": [
        "completeness",
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-FLX-02",
      "@type": "bh:Axiom",
      "label": "Variance arithmetic",
      "appliesTo": "bh:FluxAnalysis",
      "formal": "variance = current - comparison",
      "definition": "Variance equals current minus comparison.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-FLX-03",
      "@type": "bh:Axiom",
      "label": "Independent flux approval",
      "appliesTo": "bh:FluxAnalysis",
      "formal": "approver(f) != preparer(f)",
      "definition": "The person approving the flux review did not prepare it.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-MAT-01",
      "@type": "bh:Axiom",
      "label": "Materiality ordering",
      "appliesTo": "bh:Materiality",
      "formal": "0 < clearly_trivial <= performance <= overall",
      "definition": "Clearly trivial is below performance materiality, which is below overall materiality.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-SCH-01",
      "@type": "bh:Axiom",
      "label": "Schedules sum to their basis",
      "appliesTo": "bh:AmortizationSchedule",
      "formal": "sum(lines(s)) = total(s) - salvage(s)",
      "definition": "An amortization or depreciation schedule must release exactly the amount being spread, no more and no less.",
      "severity": "error",
      "assertions": [
        "accuracy_valuation"
      ]
    },
    {
      "@id": "bh:AX-SCH-02",
      "@type": "bh:Axiom",
      "label": "Net book value never negative",
      "appliesTo": "bh:FixedAsset",
      "formal": "accumulated_depreciation(a) <= cost(a) - salvage(a)",
      "definition": "Accumulated depreciation can never exceed cost less salvage value.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-IC-02",
      "@type": "bh:Axiom",
      "label": "Intercompany balances agree",
      "appliesTo": "bh:IntercompanyBalance",
      "formal": "|receivable(A,B) - payable(B,A)| <= tolerance (in reporting currency)",
      "definition": "What one entity says another owes it must equal what the other says it owes, after translation.",
      "severity": "error",
      "assertions": [
        "existence_occurrence",
        "completeness",
        "presentation_disclosure"
      ]
    },
    {
      "@id": "bh:AX-AGT-01",
      "@type": "bh:Axiom",
      "label": "Proposals are explainable",
      "appliesTo": "bh:Proposal",
      "formal": "why(p) != \"\" and 0 <= confidence(p) <= 1 and |evidence(p)| >= 1",
      "definition": "Every agent proposal says why, how confident it is, and what evidence supports it.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-AGT-02",
      "@type": "bh:Axiom",
      "label": "Untrusted text cannot authorize anything",
      "appliesTo": "bh:Proposal",
      "formal": "'injection_suspected' in risk_flags(p) -> disposition(p) != auto_apply",
      "definition": "If external text in the evidence looks like instructions, the proposal is never applied automatically.",
      "severity": "error"
    },
    {
      "@id": "bh:AX-AUD-01",
      "@type": "bh:Axiom",
      "label": "Audit chain continuity",
      "appliesTo": "bh:AuditEvent",
      "formal": "forall n > 1: prev_hash(e_n) = hash(e_{n-1}) and hash(e_n) = sha256(prev_hash(e_n) || \"\\n\" || record(e_n))",
      "definition": "Each audit event includes the hash of the previous one, so any edit to history is detectable.",
      "severity": "error"
    }
  ]
}

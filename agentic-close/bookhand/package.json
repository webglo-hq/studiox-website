{
  "name": "bookhand",
  "version": "0.1.0",
  "private": true,
  "description": "Bookhand: an agentic month-end close platform. Agents code, match, accrue, reconcile and explain under your controls; people approve.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "up": "npm run build && npm run db:setup && npm run start",
    "dev": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "start": "node dist/server/main.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:demo": "vite build --mode demo",
    "db:setup": "node dist/server/main.mjs setup",
    "db:migrate": "tsx src/server/main.ts migrate",
    "db:seed": "tsx src/server/main.ts seed",
    "db:reset": "tsx src/server/main.ts reset",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/with-postgres.mjs vitest run --project integration",
    "test:evals": "vitest run --project evals",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.demo.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "ontology:export": "tsx scripts/export-ontology.ts",
    "skills:bundle": "tsx scripts/bundle-skills.ts",
    "ads:render": "tsx scripts/render-ads.ts",
    "mcp": "tsx src/server/mcp.ts",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:evals && npm run test:integration && npm run test:e2e",
    "db:generate": "tsx scripts/gen-schema-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electric-sql/pglite": "0.5.10",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "d3-force": "3.0.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.59.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

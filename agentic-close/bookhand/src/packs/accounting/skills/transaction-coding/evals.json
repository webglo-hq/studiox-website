      },
      "expect": {
        "status": "completed",
        "counts": {
          "autoApplied": 0,
          "minPending": 100
        }
      },
      "fixture": "september-close"
    },
    {
      "id": "plain-english-rule-requires-review",
      "description": "A new plain-English rule (\"Require approval for Figma\") sends Figma charges to the inbox",
      "policy": {
        "rulesText": "Always code Figma to 6420\nRequire approval for Figma"
      },
      "input": {
        "closeId": "$closeId",
        "closeTaskId": "$task:card-coding:BW-US",
        "entity": "BW-US",
        "period": "$period"
      },
      "expect": {
        "status": "completed",
        "proposals": [
          {
            "title": "^Code FIGMA INC .* to 6420",
            "status": "pending"
          }
        ],
        "absent": [
          "^Code FIGMA INC .* to (?!6420)"
        ]
      },
      "fixture": "september-close"

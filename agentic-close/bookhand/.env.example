# Bookhand configuration. Copy to .env (loaded automatically by the server when present) and adjust.
# Every value is optional for local use. Never commit a real .env.

# HTTP
PORT=8787                   # 0 = pick a free random port (the URL is printed at startup as "READY <url>")
HOST=127.0.0.1
PUBLIC_ORIGIN=              # e.g. https://close.example.com (CSRF origin checks; https also turns on Secure cookies)
BOOKHAND_SECURE_COOKIES=    # true to force Secure cookies behind a TLS-terminating proxy
BOOKHAND_TRUST_PROXY=       # true to read the client IP from X-Forwarded-For (rate limits, audit)

# Database: leave DATABASE_URL empty to use the embedded Postgres (PGlite) under BOOKHAND_DATA_DIR
DATABASE_URL=               # e.g. postgres://bookhand:<password>@localhost:5432/bookhand
BOOKHAND_DATA_DIR=          # default .data/pglite

# Key for secrets at rest (TOTP seeds) and nothing else; at least 32 characters.
# If empty, a random key is generated once into .data/secret.key (gitignored, mode 0600).
BOOKHAND_SECRET_KEY=

# Demo company: every demo user signs in with this password. Default: the documented dev-only
# password "bookhand-demo". Set your own on any shared machine.
BOOKHAND_DEMO_PASSWORD=

# Live agents: with a key, agentic skills call Claude (default model claude-opus-5-5); without one, the
# deterministic offline engine runs. Either way every proposal passes the same verification and controls.
ANTHROPIC_API_KEY=
BOOKHAND_LLM_MODEL=         # claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
BOOKHAND_LLM_FALLBACKS=on   # server-side refusal fallback (opus/sonnet); off to disable

# Business date for the close calendar (YYYY-MM-DD). Default: the seeded scenario's date (Oct 2, 2026, WD2).
BOOKHAND_BUSINESS_DATE=

# Log every API request (method, path, status, duration) to stdout
BOOKHAND_LOG_REQUESTS=

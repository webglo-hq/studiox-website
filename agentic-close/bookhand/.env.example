# Bookhand configuration (copy to .env and adjust). Every value is optional for local use.

# HTTP
PORT=0                      # 0 = pick a free random port (printed at startup)
HOST=127.0.0.1
PUBLIC_ORIGIN=              # e.g. https://close.example.com (used for CSRF origin checks and secure cookies)

# Database: leave DATABASE_URL empty to use the embedded Postgres (PGlite) under .data/pglite
DATABASE_URL=               # e.g. postgres://bookhand:password@localhost:5432/bookhand

# Encryption key for secrets at rest (TOTP seeds). 32 random bytes, base64.
# If empty in development, a key is generated into .data/secret.key (never commit it).
BOOKHAND_SECRET_KEY=

# Demo users: passwords are generated at seed time and written to .data/demo-credentials.txt
# Set this only on a disposable local machine if you want a fixed, documented dev-only password.
BOOKHAND_DEMO_PASSWORD=

# Live LLM mode: set a key to let skills call Claude; without it the deterministic offline engine runs.
ANTHROPIC_API_KEY=
BOOKHAND_LLM_FALLBACKS=on   # server-side refusal fallback for opus/sonnet 5.5 (on|off)

# Business date override for the seeded scenario (YYYY-MM-DD). Default: the scenario's close day.
BOOKHAND_BUSINESS_DATE=
